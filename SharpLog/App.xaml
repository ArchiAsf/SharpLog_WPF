<Application
    x:Class="SharpLog.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SharpLog"
    StartupUri="/View/MainLogWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  先加载基础主题  -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <!--  HC 主题  -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml" />

                <ResourceDictionary Source="/Style/ColorDic.xaml" />
                <ResourceDictionary Source="/Style/FormStyle.xaml" />

                <!--  语言字典  -->
                <ResourceDictionary Source="/Languages/LangCN.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
