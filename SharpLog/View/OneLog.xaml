<UserControl
    x:Class="SharpLog.OneLog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SharpLog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    Height="158"
    MinWidth="0"
    MinHeight="158"
    Margin="0,0,0,3"
    d:DesignHeight="228"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Border
        Padding="0,0,4,0"
        Background="{StaticResource InPanelBackColor}"
        BorderBrush="{StaticResource PanelBackColor}"
        BorderThickness="1"
        CornerRadius="9">
        <Border.Resources>
            <!--  样式1：28号 呼号  -->
            <Style
                x:Key="CallSignBigLabelStyle"
                BasedOn="{StaticResource LabelMainTitleStyle}"
                TargetType="Label">
                <Setter Property="FontSize" Value="32" />
            </Style>

            <!--  样式2：14号 频率、网格定位  -->
            <Style
                x:Key="QsoMidLabelStyle"
                BasedOn="{StaticResource LabelMainTitleStyle}"
                TargetType="Label">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <!--  样式3：10号 时间、QTH、设备、天线、操作员  -->
            <Style
                x:Key="QsoNormalLabelStyle"
                BasedOn="{StaticResource LabelMainTitleStyle}"
                TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource LabelTertiaryNoteColor}" />
            </Style>
            <!--  样式4：6号 UTC时区后缀  -->
            <Style
                x:Key="QsoSmallLabelStyle"
                BasedOn="{StaticResource LabelMainTitleStyle}"
                TargetType="Label">
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource LabelTertiaryNoteColor}" />
            </Style>
            <!--  样式5：除呼号外的大字体  -->
            <Style
                x:Key="QsoBigLabelStyle"
                BasedOn="{StaticResource LabelMainTitleStyle}"
                TargetType="Label">
                <Setter Property="FontSize" Value="28" />
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--  左侧红色竖条 贯穿9行  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="9"
                Grid.Column="0"
                Background="{Binding CardSideBarColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{StaticResource PanelBackColor}"
                BorderThickness="0,0,2,0"
                CornerRadius="8,0,0,8" />

            <Grid Grid.Row="0" Grid.Column="1" Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1" />
                    <!--  0 侧边条 固定  -->
                    <ColumnDefinition Width="68" />
                    <!--  1 固定  -->
                    <!--  2 固定  -->
                    <ColumnDefinition Width="68" />
                    <!--  4 固定  -->
                    <ColumnDefinition Width="36" />
                    <!--  5 自适应拉伸  -->
                    <ColumnDefinition Width="*" />
                    <!--  6 自适应拉伸  -->
                    <ColumnDefinition Width="55" />
                    <!--  7 固定  -->
                    <ColumnDefinition Width="55" />
                    <!--  8 固定  -->
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="37" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="15" />
                </Grid.RowDefinitions>
                <!--  第0行 编号1  -->
                <Label
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding StartTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />
                <Label
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding TimeZoneSuffix, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoSmallLabelStyle}" />
                <Label
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="5"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding Mode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoBigLabelStyle}" />


                <!--  第1行 编号2  -->
                <Label
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding EndTime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />
                <Label
                Grid.Row="1"
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding TimeZoneSuffix, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoSmallLabelStyle}" />

                <!--  第2行 编号3 无d  -->


                <!--  第3行 编号4 呼号行【1.5倍高度】  -->
                <Label
                Grid.Row="3"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding CallSign, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource CallSignBigLabelStyle}" />
                <Label
                Grid.Row="3"
                Grid.Column="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding RST, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoBigLabelStyle}" />
                <Label
                Grid.Row="3"
                Grid.Column="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding RRST, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoBigLabelStyle}" />

                <!--  第4行 编号5 频率行【1.25倍高度】  -->
                <Label
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding DisplayFrequency, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoMidLabelStyle}" />
                <Label
                Grid.Row="4"
                Grid.Column="5"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding Locator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoMidLabelStyle}" />

                <!--  第5行 编号6 空白  -->

                <!--  第6行 编号7 QTH  -->
                <Label
                Grid.Row="6"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding QTH, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />
                <Label
                Grid.Row="6"
                Grid.Column="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding PropModeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />

                <!--  第7行 编号8 设备Rig  -->
                <Label
                Grid.Row="7"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Rig, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />

                <!--  第8行 编号9 天线 + 操作员  -->
                <Label
                Grid.Row="8"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding Antenna, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />
                <Label
                Grid.Row="8"
                Grid.Column="5"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding Operator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource QsoNormalLabelStyle}" />
            </Grid>
        </Grid>

    </Border>
</UserControl>
