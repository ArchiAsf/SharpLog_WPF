<Window
    x:Class="SharpLog.View.EditQso"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SharpLog.View"
    xmlns:conv="clr-namespace:SharpLog.View.Converters"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="编辑通联记录"
    Width="911"
    Height="425"
    MinWidth="911"
    MinHeight="400"
    MaxWidth="911"
    Style="{StaticResource LogMainWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  模式文字 → 颜色条配色（与 OneLog 卡片左侧竖条共用同一套色表）  -->
        <conv:ModeTextToColorConverter x:Key="ModeTextToColor" />
    </Window.Resources>
    <!--
        ════════════════════════════════════════════════════════════════════════
        编辑通联记录窗口的布局
        ════════════════════════════════════════════════════════════════════════
        布局来源：F:\编辑控件的布局.xlsx
        该表为【7 行 × 10 列】，对应下面 Grid 的 Row 0~6 与 Column 0~9
        （A 列 = Column 0，J 列 = Column 9）。
        
        ⚠ 注意：用户最初贴的代码里把行列数写反了
        （写成了 10 个 RowDefinition + 7 个 ColumnDefinition），
        这里以 Excel 的 7 行 × 10 列 为准。
        
        【三种元素的写法】
        · 标签（开始时间、呼号……）
        Border + EditTitlePanelStyle / Label + EditLabelStyle / TextBlock
        · 输入框（BG2GPT、14230……）
        Border + EditInputPanelStyle / TextBox + EditTextBoxStyle
        · 按钮（删除 / 取消 / 保存）
        Border + EditButtonPanelStyle / Button + EditButtonStyle
        
        ⚠ 【样式】上述 Edit 系列与滚动区 EditScroll 系列样式均已定义在
        Style/FormStyle.xaml 末尾，风格与设置页、主界面保持一致。
        
        【滚动区域】
        Grid.Row 2~6 × Grid.Column 3~7（Excel 的 D3:H7）是一块【独立的可滚动表格区】，
        结构与字段清单见文件末尾该区域的注释。
        ════════════════════════════════════════════════════════════════════════
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="290" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="0"
            Padding="3"
            Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="39" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <!--  ══════════════════ 第 1 行 ══════════════════  -->

                <!--  A1：开始时间（标签）  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="开始时间" />
                    </Label>
                </Border>

                <!--  B1:C1：开始时间（输入框，跨 2 列）  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <hc:DateTimePicker
                        SelectedDateTime="{Binding StartTimeDT, Mode=TwoWay}"
                        Style="{StaticResource EditDateTimePickerStyle}" />
                </Border>

                <!--  D1：utc（单位文字，样式暂用标签样式）  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="3"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="utc" />
                    </Label>
                </Border>

                <!--
                    H1:J1：颜色条（跨 2 列）
                    用途：按【通联模式】取色，与 OneLog 卡片左侧竖条共用同一套色表
                          （StaticValues.ModeColorMap）。
                    取色见 View/Converters/EditQsoConverters.cs：
                    模式文字 → 整串精确匹配 → 取首个词再匹配 → 中性灰兜底。
                    ⚠ 这里用 ElementName 直接绑主表那个模式输入框，改文字颜色实时变；
                      将来字段正式接数据后，改成绑 ViewModel 的模式属性即可。
                -->
                <Border
                    Grid.Row="0"
                    Grid.Column="6"
                    Grid.ColumnSpan="3"
                    Background="{Binding ModeDisplayName, Converter={StaticResource ModeTextToColor}}"
                    CornerRadius="4,0,0,4"
                    Margin="0,0,-2,0"
                    Height=" 20"
                    Style="{StaticResource EditInputPanelStyle}" />

                <!--  ══════════════════ 第 2 行 ══════════════════  -->

                <!--  A2：结束时间（标签）  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="结束时间" />
                    </Label>
                </Border>

                <!--  B2:C2：结束时间（输入框，跨 2 列）  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <hc:DateTimePicker
                        SelectedDateTime="{Binding EndTimeDT, Mode=TwoWay}"
                        Style="{StaticResource EditDateTimePickerStyle}" />
                </Border>

                <!--  D2：utc  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="3"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="utc" />
                    </Label>
                </Border>

                <!--  H2：传播模式（标签）  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="6"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="传播模式" />
                    </Label>
                </Border>

                <!--  I2：传播模式（输入框）  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="7"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <ComboBox
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding PropagationModeList}"
                        SelectedItem="{Binding SelectPROPItem}"
                        Style="{StaticResource EditComboBoxStyle}" />
                </Border>



                <!--  ══════════════════ 第 3 行 ══════════════════  -->

                <!--  A3：呼号（标签）  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="呼号" />
                    </Label>
                </Border>

                <!--  B3:C3：呼号（输入框，跨 2 列）  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <TextBox Style="{StaticResource EditTextBoxStyle}" Text="{Binding CALL, Mode=TwoWay}" />
                </Border>

                <!--  ══════════════════ 第 4 行 ══════════════════  -->

                <!--  A4：模式（标签）  -->
                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="模式" />
                    </Label>
                </Border>

                <!--  B4:C4：模式（输入框，跨 2 列）  -->
                <!--  ⚠ 这一格实际应改为 ComboBox（绑定模式下拉列表），待样式确定后再调整  -->
                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <ComboBox
                        x:Name="ModeComboBox"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding CommModeList}"
                        SelectedItem="{Binding SelectCommMode}"
                        Style="{StaticResource EditComboBoxStyle}" />
                </Border>

                <!--  I4：分组（标签）  -->
                <Border
                    Grid.Row="3"
                    Grid.Column="8"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="分组" />
                    </Label>
                </Border>



                <!--  ══════════════════ 第 5 行 ══════════════════  -->

                <!--  A5：频率（标签）  -->
                <Border
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="频率" />
                    </Label>
                </Border>

                <!--  B5:C5：频率（输入框，跨 2 列）  -->
                <Border
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <TextBox Style="{StaticResource EditTextBoxStyle}" Text="{Binding FREQ, Mode=TwoWay}" />
                </Border>

                <!--  I5：分组的值（输入框）  -->
                <Border
                    Grid.Row="4"
                    Grid.Column="8"
                    Style="{StaticResource EditInputPanelStyle}">
                    <hc:NumericUpDown
                        Maximum="5"
                        Minimum="0"
                        Style="{StaticResource EditNumericUpDownStyle}"
                        Value="{Binding GroupID}" />
                </Border>

                <!--  ══════════════════ 第 6 行 ══════════════════  -->

                <!--  A6：收/发信号报告（标签）  -->
                <Border
                    Grid.Row="5"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="收/发信号报告" />
                    </Label>
                </Border>

                <!--  B6：信号报告（输入框，单格）  -->
                <Border
                    Grid.Row="5"
                    Grid.Column="1"
                    Style="{StaticResource EditInputPanelStyle}">
                    <TextBox Style="{StaticResource EditTextBoxStyle}" Text="{Binding RST_RCVD, Mode=TwoWay}" />
                </Border>

                <!--  C6：信号报告（输入框，单格）  -->
                <!--  行 6 的 B、C 两列没有合并，是两个独立输入框（收报告 / 发报告）  -->
                <Border
                    Grid.Row="5"
                    Grid.Column="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <TextBox Style="{StaticResource EditTextBoxStyle}" Text="{Binding RST_SENT, Mode=TwoWay}" />
                </Border>

                <!--  I6：星级（标签）  -->
                <Border
                    Grid.Row="5"
                    Grid.Column="8"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="星级" />
                    </Label>
                </Border>



                <!--  ══════════════════ 第 7 行 ══════════════════  -->

                <!--  A7：网格（标签）  -->
                <Border
                    Grid.Row="6"
                    Grid.Column="0"
                    Style="{StaticResource EditTitlePanelStyle}">
                    <Label Style="{StaticResource EditLabelStyle}">
                        <TextBlock Text="网格" />
                    </Label>
                </Border>

                <!--  B7:C7：网格（输入框，跨 2 列）  -->
                <Border
                    Grid.Row="6"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource EditInputPanelStyle}">
                    <TextBox Style="{StaticResource EditTextBoxStyle}" Text="{Binding GRIDSQUARE, Mode=TwoWay}" />
                </Border>

                <!--  I7：星级的值（输入框）  -->
                <Border
                    Grid.Row="6"
                    Grid.Column="8"
                    Style="{StaticResource EditInputPanelStyle}">
                    <hc:NumericUpDown
                        Maximum="5"
                        Minimum="0"
                        Style="{StaticResource EditNumericUpDownStyle}"
                        Value="{Binding StarID}" />
                </Border>

                <!--  按钮组  -->

                <Border
                    Grid.Row="1"
                    Grid.Column="9"
                    Grid.ColumnSpan="6" />

                <!--
                    ════════════════════════════════════════════════════════════════════════
                    滚动区域
                    ════════════════════════════════════════════════════════════════════════
                    对应 Excel 的 D3:H7，即 Grid.Row 2~6 × Grid.Column 3~7。
                    
                    【结构】
                    Border（外框）
                    └ ScrollViewer（负责纵向滚动）
                    └ StackPanel
                    └ Grid（每行一条字段）
                    左列 3 份宽 = 字段名，用标签组件
                    右列 7 份宽 = 字段值，用输入框组件
                    行数可随字段增减，列固定为两列。
                    
                    【本区与主表的分工】
                    主表已占用：开始/结束时间、呼号、模式、频率、网格、
                    传播模式、收/发信号报告、分组、星级。
                    本区放其余【常用字段】。
                    ⚠ 按用户要求，QSL 卡片管理相关的字段
                    （QSL已收 / 收卡日期 / 发卡日期 / QSL地址 / 邮政编码 /
                    收件人 / 联系方式）本次【不】放入本区。
                    
                    ⚠ 它声明在最后：Grid 的子元素是「后声明的在上层」，
                    而这块区域跨度大，放最后可以盖住可能重叠的其他元素，
                    不会被别的格子遮挡。
                    ════════════════════════════════════════════════════════════════════════
                -->
                <Border
                    Grid.Row="2"
                    Grid.RowSpan="5"
                    Grid.Column="3"
                    Grid.ColumnSpan="5"
                    Style="{StaticResource EditScrollPanelStyle}">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="7*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="地理位置" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QTH, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="接收功率" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding RX_PWR, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="发射功率" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding TX_PWR, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="设备" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding RIG, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="天线" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding ANT, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="天线高度" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding Height, Mode=TwoWay}" />
                                </Border>

                                <Border
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="对方值机员" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding CONTACTED_OP, Mode=TwoWay}" />
                                </Border>


                                <Border
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="结束日期" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QSO_DATE_OFF, Mode=TwoWay}" />
                                </Border>
                                <Border
                                    Grid.Row="8"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="结束时间" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding TIME_OFF, Mode=TwoWay}" />
                                </Border>
                                <Border
                                    Grid.Row="9"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="天气" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="9"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding Weather, Mode=TwoWay}" />
                                </Border>
                                <Border
                                    Grid.Row="10"
                                    Grid.Column="0"
                                    Style="{StaticResource EditScrollTitlePanelStyle}">
                                    <Label Style="{StaticResource EditScrollLabelStyle}">
                                        <TextBlock Text="温度" />
                                    </Label>
                                </Border>
                                <Border
                                    Grid.Row="10"
                                    Grid.Column="1"
                                    Style="{StaticResource EditScrollInputPanelStyle}">
                                    <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding Temperature, Mode=TwoWay}" />
                                </Border>

                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!--  按钮区  -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  J2:J3：删除按钮（跨 2 行）  -->
                <Border Grid.Row="0" Style="{StaticResource EditButtonPanelStyle}">
                    <Button
                        Command=""
                        Content="删&#x0a;除"
                        Style="{StaticResource EditButtonStyle}" />
                </Border>
                <!--  J4:J5：取消按钮（跨 2 行）  -->
                <Border Grid.Row="1" Style="{StaticResource EditButtonPanelStyle}">
                    <Button
                        Command=""
                        Content="取&#x0a;消"
                        Style="{StaticResource EditButtonStyle}" />
                </Border>

                <!--  J6:J7：保存按钮（跨 2 行）  -->
                <Border Grid.Row="3" Style="{StaticResource EditButtonPanelStyle}">
                    <Button
                        Command=""
                        Content="保&#x0a;存"
                        Style="{StaticResource EditButtonStyle}" />
                </Border>
            </Grid>
        </Border>


        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                    <ScrollViewer>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="QSL已收" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QSL_RCVD, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="收卡日期" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QSLRDATE, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="发卡日期" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QSLSDATE, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="QSL地址" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding QslAddress, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="邮政编码" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding PostalCode, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="收件人" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding ReceiverName, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="联系方式" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding ReceiverContact, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="本站操作员" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding RadioOperator, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="8"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="时区" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding TimeZone, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="9"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="DMR ID" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding DigitalID, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="10"
                                Grid.Column="0"
                                Style="{StaticResource EditScrollTitlePanelStyle}">
                                <Label Style="{StaticResource EditScrollLabelStyle}">
                                    <TextBlock Text="双向确认" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="10"
                                Grid.Column="1"
                                Style="{StaticResource EditScrollInputPanelStyle}">
                                <TextBox Style="{StaticResource EditScrollTextBoxStyle}" Text="{Binding IsConfirmed, Mode=TwoWay}" />
                            </Border>

                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  标题行按内容高度，其余全给输入框  -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Style="{StaticResource EditScrollTitlePanelStyle}">
                            <Label Style="{StaticResource EditScrollLabelStyle}">
                                <TextBlock Text="备注 COMMENT" />
                            </Label>
                        </Border>

                        <!--
                          多行备注输入框
                          · AcceptsReturn —— 回车换行，而不是触发默认按钮
                          · TextWrapping  —— 到边自动折行
                          · VerticalContentAlignment=Top —— 多行时从顶部开始写
                          · VerticalScrollBarVisibility=Auto —— 内容超出才出滚动条
                             （EditTextBoxStyle 的模板已把该属性接到 PART_ContentHost）
                        -->
                        <Border
                            Grid.Row="1"
                            Style="{StaticResource EditScrollInputPanelStyle}">
                            <TextBox
                                AcceptsReturn="True"
                                Style="{StaticResource EditScrollTextBoxStyle}"
                                Text="{Binding COMMENT, Mode=TwoWay}"
                                TextAlignment="Left"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ══════════════════════════════════════════════════════════════════
              【编辑窗口】的消息提示面板（右下角）
              ──────────────────────────────────────────────────────────────────
              ⚠ Token 必须是 "EditQsoGrowl"，与 ToolsBox\MessageTools.cs 里
                MessagePage.EditQso 分支返回的字符串【一字不差】，
                否则消息找不到这个面板（表现为消息不显示或跑到别处）。

              ⚠ 声明在最后：Grid 的子元素是「后声明的在上层」，
                放最后才能保证提示浮在其它内容之上。
              ══════════════════════════════════════════════════════════════════  -->
        <StackPanel
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Margin="0,0,10,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            hc:Growl.GrowlParent="True"
            hc:Growl.ShowMode="Append"
            hc:Growl.Token="EditQsoGrowl" />
    </Grid>
</Window>
