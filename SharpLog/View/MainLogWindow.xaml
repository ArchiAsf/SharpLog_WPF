<Window
    x:Class="SharpLog.MainLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SharpLog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:conv="clr-namespace:SharpLog.View.Converters"
    Title="SharpLog"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    Closing="ClosingChange"
    Style="{StaticResource LogMainWindowStyle}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <!--
      日志查看表格用到的值转换器。
      数据库实体里存的是 ADIF 标准原始值（频率存 kHz、模式存主模式代码、
      时间存 HHmmss 不带冒号……），不能直接显示给用户看，需要这几只转换器
      在绑定时把它们变成可读的写法。实现见 View\Converters\LogViewConverters.cs
    -->
    <Window.Resources>
        <conv:FreqToBandConverter x:Key="FreqToBand" />
        <conv:ModeDisplayConverter x:Key="ModeDisplay" />
        <conv:PropModeDisplayConverter x:Key="PropModeDisplay" />
        <conv:TimeDisplayConverter x:Key="TimeDisplay" />
        <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />
    </Window.Resources>

    <TabControl Style="{StaticResource DarkTabControlStyle}">
        <TabItem Header="日志编辑" Style="{StaticResource DarkTabItemStyle}">
            <Border Margin="0" Style="{StaticResource CardPanelStyle}">
                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition
                            Width="780*"
                            MinWidth="780"
                            MaxWidth="15000" />
                        <ColumnDefinition
                            Width="103*"
                            MinWidth="360"
                            MaxWidth="600" />
                        <ColumnDefinition Width="273*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition MinHeight="380" MaxHeight="600" />
                        <RowDefinition MinHeight="200" MaxHeight="100000000" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <!--  顶部工具栏容器  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                        </Grid>


                    </Border>

                    <!--  中左侧第小工具一列栏  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        <!--  左侧栏划分表格  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="220" />
                                <RowDefinition Height="180" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  时间显示区实现  -->
                            <Border Style="{StaticResource CardPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="7.5*" />
                                        <RowDefinition Height="2.5*" />
                                        <RowDefinition Height="2.0*" />
                                    </Grid.RowDefinitions>
                                    <!--  上方时间区  -->
                                    <Border BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>


                                            <!--  UTC时间区  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1.5*" />
                                                        <RowDefinition Height="3*" />
                                                        <RowDefinition Height="1*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeLabelStyle}">
                                                            <TextBlock>
                                                                UTC时间
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Border Style="{StaticResource TimeBorder}">
                                                            <Label Style="{StaticResource TimeStyle}">
                                                                <TextBlock Text="{Binding UtcTime}" TextAlignment="Center" />
                                                            </Label>
                                                        </Border>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="3,0,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                        <Label Style="{StaticResource UTCZoneStyle}">
                                                            <TextBlock Text="{Binding UtcTimeZone}">
                                                                UTC
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeDataStyle}">
                                                            <TextBlock Text="{Binding UtcDate}" />
                                                        </Label>
                                                    </Border>

                                                </Grid>
                                            </Border>

                                            <!--  地区时间区  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1.5*" />
                                                        <RowDefinition Height="3*" />
                                                        <RowDefinition Height="1*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeLabelStyle}">
                                                            <TextBlock>
                                                                时区时间
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Border Style="{StaticResource TimeBorder}">
                                                            <Label Style="{StaticResource TimeStyle}">
                                                                <TextBlock Text="{Binding LocalTime}" TextAlignment="Center" />
                                                            </Label>
                                                        </Border>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="3,0,0,0"
                                                        Padding="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                        <Label Style="{StaticResource UTCZoneStyle}">
                                                            <TextBlock Text="{Binding LocalTimeZone}" />
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeDataStyle}">
                                                            <TextBlock Text="{Binding LocalDate}" />
                                                        </Label>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <!--  晨昏显示区  -->
                                    <Border
                                        Grid.Row="1"
                                        BorderBrush="{StaticResource PanelBorderColor}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="3.5*" />
                                                <ColumnDefinition Width="3.5*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7*" />
                                                <RowDefinition Height="5.5*" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,1,0">

                                                <!--  时段图标：随 黎明/日间/黄昏/夜间 自动切换（图片在 logo 目录下）  -->
                                                <Image Margin="2" Source="{Binding DayPeriodIconPath}" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,8,0"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource TimeLabelStyle}">
                                                        <TextBlock>
                                                            当前时刻为:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Margin="1,0"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  时段文字：与左侧图标同步切换  -->
                                                        <TextBlock Text="{Binding DayPeriodText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,1,0">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <TextBlock>
                                                            日出:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  日出时刻：由 VM 每天零点重算（民用晨昏）  -->
                                                        <TextBlock Text="{Binding SunriseText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1" Grid.Column="2">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <TextBlock>
                                                            日落:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  日落时刻：由 VM 每天零点重算（民用晨昏）  -->
                                                        <TextBlock Text="{Binding SunsetText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>




                                        </Grid>
                                    </Border>

                                    <!--  转换时区按钮  -->
                                    <Border Grid.Row="2">
                                        <Button
                                            Margin="5"
                                            Command="{Binding ConvertTimeZoneCommand}"
                                            Content="时区转换"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </Border>

                                </Grid>
                            </Border>



                        </Grid>
                    </Border>

                    <!--  中间主要日志填写栏  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <Grid Grid.RowSpan="2" Grid.Column="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding StartTimeTextClick_TimeInPutStartTimeCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <!--  字段标签：开始时间（复合输入，后台拆分存储为 QSO_DATE + TIME_ON）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·开始时间" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  开始时间输入框（hc:DateTimePicker 复合输入，后台拆分存储）  -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <hc:DateTimePicker SelectedDateTime="{Binding StartTimeDT, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding EndTimeTextClick_TimeInPutEndTimeCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <!--  字段标签：结束时间（复合输入，后台拆分存储为 QSO_DATE_OFF + TIME_OFF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·结束时间" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  结束时间输入框（hc:DateTimePicker 复合输入，后台拆分存储）  -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <hc:DateTimePicker SelectedDateTime="{Binding EndTimeDT, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：备注 COMMENT（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="备注" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：呼号 CALL（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·呼号" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  呼号输入框（ADIF: CALL）  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="CALLInPutBox"
                                    FontFamily="Consolas"
                                    FontSize="22"
                                    Foreground="{StaticResource AccentTextColor}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding CALL, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：模式 Mode  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·模式" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  模式输入框  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <!--
                                    通联模式下拉框。
                                    DisplayMemberPath 指向 ModeItem.DisplayName（界面显示名，
                                    如 "D-STAR"），而不是 Mode（ADIF 主模式 "DIGITALVOICE"），
                                    这样用户看到的是自己熟悉的模式名。
                                    选中项由 SelectedItem 绑定（不用 SelectedValue）。
                                -->
                                <ComboBox
                                    Background="{StaticResource NormalTextBoxBackColor}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding CommModeList}"
                                    SelectedItem="{Binding SelectCommMode}" />

                            </Border>

                            <!--  备注多行输入框（ADIF: COMMENT，纵向跨6行，右侧大区域）  -->
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="7"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="COMMENTInPutBox"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    FontSize="14"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding COMMENT, Mode=TwoWay}"
                                    TextAlignment="Justify"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：频率 FREQ（ADIF，单位kHz）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·频率" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  频率输入框（ADIF: FREQ，kHz）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="FREQInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="kHz"
                                    Text="{Binding FREQ, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：信号报告_收 RST_RCVD（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="信号报告_收" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  接收信号报告输入框（ADIF: RST_RCVD）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="3"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RST_RCVDInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RST_RCVD, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：信号报告_发 RST_SENT（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="信号报告_发" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射信号报告输入框（ADIF: RST_SENT）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RST_SENTInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RST_SENT, Mode=TwoWay}" />
                            </Border>


                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：网格 GRIDSQUARE（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="网格" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  网格输入框（ADIF: GRIDSQUARE）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="GRIDSQUAREInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding GRIDSQUARE, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射功率_收 RX_PWR（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射功率_收" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  接收功率输入框（ADIF: RX_PWR）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="3"
                                Grid.ColumnSpan="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RX_PWRInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="W"
                                    Text="{Binding RX_PWR, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射功率_发 TX_PWR（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射功率_发" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射功率输入框（ADIF: TX_PWR）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="5"
                                Grid.ColumnSpan="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="TX_PWRInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="W"
                                    Text="{Binding TX_PWR, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：地理位置 QTH  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="地理位置" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  QTH地理位置输入框（ADIF: QTH）  -->
                            <Border
                                Grid.Row="4"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="QTHInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding QTH, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：设备 RIG  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="设备" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  设备RIG输入框（ADIF: RIG）  -->
                            <Border
                                Grid.Row="5"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RIGInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RIG, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：天线 ANT  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="天线" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  天线ANT输入框  -->
                            <Border
                                Grid.Row="6"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="AntInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding Ant, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射高度 Height  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射高度" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射高度 Height输入框  -->
                            <Border
                                Grid.Row="7"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="HeightInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="M"
                                    Text="{Binding Height, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="7"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">

                                <!--  字段标签：对方值机员 CONTACTED_OP（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="值机员" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--
                                对方电台值机员输入框（指对方实际操作的台）
                                ⚠ 与「本站操作员」不同：本站呼号来自设置页的 STATION_CALLSIGN
                            -->
                            <Border
                                Grid.Row="7"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding CONTACTED_OP, Mode=TwoWay}" />
                            </Border>




                            <Border
                                Grid.Row="8"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：传播模式 PROP_MODE（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="传播模式" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  传播模式 Propagation Mode输入框  -->
                            <Border
                                Grid.Row="8"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">

                                <!--
                                    传播模式下拉框。
                                    DisplayMemberPath 指向 PropagationItem.DisplayName
                                    （格式为「中文 + 代码」，如 "F2层反射 F2"）。
                                    选中首项「（不指定）」时 Code 为 null，
                                    存库时 QsoLog.PROP_MODE 写 NULL。
                                -->
                                <ComboBox
                                    Background="{StaticResource NormalTextBoxBackColor}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding PropagationModeList}"
                                    SelectedItem="{Binding SelectPROPItem}" />

                            </Border>

                            <Border
                                Grid.Row="8"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">

                                <!--  字段标签：DMRID  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="数字ID" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  DMRID输入框  -->
                            <Border
                                Grid.Row="8"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="DMRIDInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding DigID, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="8"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <Button
                                    Command="{Binding AddLogBtnClickCommand}"
                                    Content="添加日志"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </Border>


                        </Grid>
                    </Border>

                    <!--  中间下方栏  -->
                    <!--  这里我想实现一个输入呼号后通过解析呼号能得出对方的国家后显示国旗图标然后还有国家名字，还有对应呼号的字母解释法，生成界面代码即可不用对应的功能实现代码  -->
                    <TabControl
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="2,2,2,2"
                        Style="{StaticResource InDarkTabControlStyle}">
                        <TabItem
                            Height="18"
                            Header="其他信息"
                            Style="{StaticResource InDarkTabItemStyle}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>


                                <Border BorderBrush="{StaticResource TabBorderBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                                        VerticalScrollBarVisibility="Visible">
                                        <Border />
                                    </ScrollViewer>
                                </Border>

                                <ScrollViewer
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                                    VerticalScrollBarVisibility="Visible">
                                    <!--  日志其他信息区  -->
                                    <Border Height="240" Padding="0,0,1.5,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>

                                            <!--  ====================== 第0行：分组、星标数字输入区域 ======================  -->
                                            <!--  分组 文字标签容器  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <!--  使用动态资源实现多语言文本  -->
                                                    <TextBlock Text="{DynamicResource Text_Group}" />
                                                </Label>
                                            </Border>

                                            <!--  分组数值输入框，hc数字增减控件  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="0,2,0,2">
                                                <hc:NumericUpDown
                                                    FontSize="16"
                                                    Maximum="5"
                                                    Minimum="0"
                                                    Value="{Binding GroupID}" />
                                            </Border>

                                            <!--  星标 文字标签容器  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_Star}" />
                                                </Label>
                                            </Border>

                                            <!--  星标等级数值输入框  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:NumericUpDown
                                                    FontSize="16"
                                                    Maximum="5"
                                                    Minimum="0"
                                                    Value="{Binding StarID}" />
                                            </Border>

                                            <!--  ====================== 第1行：是否已收妥QSL卡片下拉选择 ======================  -->
                                            <!--  标签，横跨0、1、2三列  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslReceived}" />
                                                </Label>
                                            </Border>

                                            <!--  下拉选择框：是 / 否（ADIF: QSL_RCVD）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:ComboBox Text="{Binding QSL_RCVD}">
                                                    <hc:ComboBox.Items>
                                                        <system:String>是</system:String>
                                                        <system:String>否</system:String>
                                                    </hc:ComboBox.Items>
                                                </hc:ComboBox>
                                            </Border>

                                            <!--  ====================== 第2行：QSL收发日期选择区域 ======================  -->
                                            <!--  QSL卡收到时间 标签  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslReceiveTime}" />
                                                </Label>
                                            </Border>

                                            <!--  QSL收到日期选择器（ADIF: QSLRDATE）  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Padding="0,2,0,2">
                                                <hc:DatePicker SelectedDate="{Binding QSLRDATE}" />
                                            </Border>

                                            <!--  QSL卡发出时间 标签  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslSendTime}" />
                                                </Label>
                                            </Border>

                                            <!--  QSL发出日期选择器（ADIF: QSLSDATE）  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:DatePicker SelectedDate="{Binding QSLSDATE}" />
                                            </Border>

                                            <!--  ====================== 第3行：QSL卡片邮寄地址标题 ======================  -->
                                            <!--  标签横跨全部4列  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslMailAddress}" />
                                                </Label>
                                            </Border>

                                            <!--  ====================== 第4行：QSL完整邮寄地址输入框 ======================  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding QslAddress}" />
                                            </Border>

                                            <!--  ====================== 第5行：邮政编码、收件人姓名 ======================  -->
                                            <!--  邮政编码 标签，横跨0、1列  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_PostalCode}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人姓名 标签  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_ReceiverName}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人姓名输入框  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="3"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding ReceiverName}" />
                                            </Border>

                                            <!--  ====================== 第6行：邮政编码输入框、收件人联系方式 ======================  -->
                                            <!--  邮政编码输入框，横跨0、1列  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding PostalCode}" />
                                            </Border>

                                            <!--  收件人联系方式 标签  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_ReceiverContact}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人联系方式输入框  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="3"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding ReceiverContact}" />
                                            </Border>


                                            <!--  因为表格空间限制，不得不删除掉气温和天气的填写，后续版本再添加上吧  -->
                                            <!--<Border
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Style="{StaticResource LittleCardPanelStyle}">
                                            <Label Style="{StaticResource LittleLabelStyle}">
                                                <TextBlock Text="{DynamicResource Text_Weather}" />
                                            </Label>
                                        </Border>

                                        <Border
                                            Grid.Row="7"
                                            Grid.Column="2"
                                            Style="{StaticResource LittleCardPanelStyle}">
                                            <Label Style="{StaticResource LittleLabelStyle}">
                                                <TextBlock Text="{DynamicResource Text_Temperature}" />
                                            </Label>
                                        </Border>-->


                                        </Grid>
                                    </Border>
                                </ScrollViewer>

                            </Grid>
                        </TabItem>
                        <TabItem Height="18" Style="{StaticResource InDarkTabItemStyle}" />
                    </TabControl>

                    <!--  右侧日志显示容器  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsControl
                                x:Name="QsoItemsControl"
                                Padding="0,0,1,0"
                                ItemsSource="{Binding QsoLogCollection}">
                                <!--  布局面板：动态项排列方式  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--  可选：垂直排列StackPanel / 自适应WrapPanel / Grid  -->
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!--  项外边距，卡片之间间距  -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,8" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!--  底部容器  -->
                    <Border
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{DynamicResource Text_NowTimeZone}" />
                                </Label>
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{Binding ZoneName}" />
                                </Label>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!--  使用hc实现消息提示  -->
                    <StackPanel
                        Grid.RowSpan="4"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Width="auto"
                        Margin="0,340,5,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        hc:Growl.GrowlParent="True"
                        hc:Growl.ShowMode="Append"
                        hc:Growl.Token="WarningShowBox" />

                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="日志查看" Style="{StaticResource DarkTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="450" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardPanelStyle}">
                    
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  表格占满剩余高度  -->
                            <RowDefinition Height="*" />
                            <!--  「加载更多」常驻表格下方，不随表格内容滚动  -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                          日志数据表格。
                          · 列由 XAML 手工定义（AutoGenerateColumns=False）：
                            这样表头可以左右拖拽换位（CanUserReorderColumns），
                            自动生成的列在重新绑定时会被重建，顺序就丢了。
                          · 只读：编辑走双击/右键弹出的悬浮窗口，不在这里直接改。
                        -->
                        <DataGrid
                            x:Name="LogViewDataGrid"
                            Grid.Row="0"
                            ItemsSource="{Binding LogViewRows}"
                            Loaded="LogViewDataGrid_Loaded"
                            SelectedItem="{Binding SelectedLogViewRow, Mode=TwoWay}"
                            Style="{StaticResource DarkDataGridStyle}">

                            <!--  双击整行 → 打开编辑窗口  -->
                            <DataGrid.InputBindings>
                                <MouseBinding
                                    Command="{Binding OpenLogEditCommand}"
                                    CommandParameter="{Binding SelectedLogViewRow}"
                                    MouseAction="LeftDoubleClick" />
                            </DataGrid.InputBindings>

                            <!--  右键 → 行操作菜单  -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <MenuItem
                                        Command="{Binding OpenLogEditCommand}"
                                        CommandParameter="{Binding SelectedLogViewRow}"
                                        Header="更改该记录"
                                        Style="{StaticResource DarkMenuItemStyle}" />
                                    <MenuItem
                                        Command="{Binding DeleteLogCommand}"
                                        CommandParameter="{Binding SelectedLogViewRow}"
                                        Header="删除该记录"
                                        Style="{StaticResource DarkMenuItemStyle}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <!--  ==================== 最常用的核心字段排在最前 ====================  -->
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding QSO_DATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="日期" />
                                <DataGridTextColumn
                                    Width="74"
                                    Binding="{Binding TIME_ON, Converter={StaticResource TimeDisplay}}"
                                    Header="时间" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding CALL}"
                                    Header="呼号" />
                                <DataGridTextColumn
                                    Width="86"
                                    Binding="{Binding FREQ}"
                                    Header="频率(kHz)" />
                                <!--  波段不是数据库字段，是由频率查 ADIF 波段表算出来的  -->
                                <DataGridTextColumn
                                    Width="56"
                                    Binding="{Binding FREQ, Converter={StaticResource FreqToBand}}"
                                    Header="波段" />
                                <!--
                                  模式由 MODE + SUBMODE 两级反查成界面显示名。
                                  直接显示 MODE 的话，界面选 FT4 的会显示成 MFSK，
                                  选 D-STAR 的会显示成 DIGITALVOICE，用户根本认不出来。
                                -->
                                <DataGridTextColumn Width="98" Header="模式">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource ModeDisplay}">
                                            <Binding Path="MODE" />
                                            <Binding Path="SUBMODE" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="74"
                                    Binding="{Binding SUBMODE}"
                                    Header="子模式" />
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding RST_SENT}"
                                    Header="信号报告(发)" />
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding RST_RCVD}"
                                    Header="信号报告(收)" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding PROP_MODE, Converter={StaticResource PropModeDisplay}}"
                                    Header="传播模式" />

                                <!--  ==================== 对方电台信息 ====================  -->
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding QTH}"
                                    Header="对方城市" />
                                <DataGridTextColumn
                                    Width="88"
                                    Binding="{Binding GRIDSQUARE}"
                                    Header="网格定位" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding RX_PWR}"
                                    Header="对方功率" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding TX_PWR}"
                                    Header="我方功率" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding RIG}"
                                    Header="对方设备" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding ANT}"
                                    Header="对方天线" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Height}"
                                    Header="天线高度" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding CONTACTED_OP}"
                                    Header="对方值机员" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding RadioOperator}"
                                    Header="本站操作员" />

                                <!--  ==================== 通联结束时刻 ====================  -->
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding QSO_DATE_OFF, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="结束日期" />
                                <DataGridTextColumn
                                    Width="74"
                                    Binding="{Binding TIME_OFF, Converter={StaticResource TimeDisplay}}"
                                    Header="结束时间" />
                                <DataGridTextColumn
                                    Width="72"
                                    Binding="{Binding TimeZone}"
                                    Header="时区" />

                                <!--  ==================== QSL 卡片管理 ====================  -->
                                <DataGridTextColumn
                                    Width="72"
                                    Binding="{Binding QSL_RCVD, Converter={StaticResource BoolToYesNo}}"
                                    Header="QSL已收" />
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding QSLRDATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="收卡日期" />
                                <DataGridTextColumn
                                    Width="92"
                                    Binding="{Binding QSLSDATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="发卡日期" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding QslAddress}"
                                    Header="QSL地址" />
                                <DataGridTextColumn
                                    Width="86"
                                    Binding="{Binding PostalCode}"
                                    Header="邮政编码" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding ReceiverName}"
                                    Header="收件人" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding ReceiverContact}"
                                    Header="联系方式" />

                                <!--  ==================== 项目自定义字段 ====================  -->
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding DigitalID}"
                                    Header="DMR ID" />
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding GroupID}"
                                    Header="分组" />
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding StarID}"
                                    Header="星级" />
                                <DataGridTextColumn
                                    Width="72"
                                    Binding="{Binding Weather}"
                                    Header="天气" />
                                <DataGridTextColumn
                                    Width="72"
                                    Binding="{Binding Temperature}"
                                    Header="温度" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding IsConfirmed, Converter={StaticResource BoolToYesNo}}"
                                    Header="双向确认" />
                                <DataGridTextColumn
                                    Width="220"
                                    Binding="{Binding COMMENT}"
                                    Header="备注" />

                                <!--  ==================== 记录元数据 ====================  -->
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                    Header="创建时间" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding LastUpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                    Header="最后修改" />
                                <DataGridTextColumn
                                    Width="72"
                                    Binding="{Binding Id}"
                                    Header="记录ID" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--
                          「加载更多」。
                          ⚠ 它放在表格【外面】，而不是塞进表格的最后一行：
                            DataGrid 的单元格不支持跨列合并，想在最后一行显示整句
                            「已加载 N 条，点击继续加载」只能挤在某一列的宽度里，
                            根本显示不全。放在表格正下方既完整可见，又不受横向滚动影响。
                          防连点由 VM 的 IsLoadingMore 负责：加载期间按钮自动禁用。
                        -->
                        <Button
                            Grid.Row="1"
                            Command="{Binding LoadMoreLogViewCommand}"
                            Content="{Binding LoadMoreText}"
                            Style="{StaticResource LoadMoreLinkStyle}" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPanelStyle}">

                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="设置" Style="{StaticResource DarkTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}">
                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                        VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <Border Style="{StaticResource OptionCardPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*" />
                                        <RowDefinition Height="8*" />
                                    </Grid.RowDefinitions>
                                    <!--  标题  -->
                                    <Border Grid.Row="0" Style="{StaticResource OptionCardTitilePanelStyle}">
                                        <hc:Divider
                                            Margin="-1,0,-1,0"
                                            VerticalAlignment="Top"
                                            Content="本地台站设置"
                                            Style="{StaticResource OptionDividerStyle}" />
                                    </Border>
                                    <!--  选项区  -->
                                    <Border Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>

                                            <!--  ══════════════ 第 1 行 ══════════════  -->

                                            <!--  呼号（ADIF: STATION_CALLSIGN，本站呼号）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="呼号" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding STATION_CALLSIGN}" />
                                            </Border>

                                            <!--  值班员（ADIF: OPERATOR，日志操作员呼号）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="值班员" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding OPERATOR}" />
                                            </Border>

                                            <!--  DXCC代码（ADIF: MY_DXCC）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="DXCC代码" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="5"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_DXCC}" />
                                            </Border>

                                            <!--  CQ分区（ADIF: MY_CQ_ZONE）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="6"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="CQ分区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="7"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_CQ_ZONE}" />
                                            </Border>

                                            <!--  ITU分区（ADIF: MY_ITU_ZONE）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="8"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="ITU分区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="9"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_ITU_ZONE}" />
                                            </Border>

                                            <!--  ══════════════ 第 2 行 ══════════════  -->

                                            <!--  网格（ADIF: MY_GRIDSQUARE）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="网格" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_GRIDSQUARE}" />
                                            </Border>

                                            <!--  国家/地区（ADIF: MY_COUNTRY）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="国家/地区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_COUNTRY}" />
                                            </Border>

                                            <!--  经度（ADIF: MY_LON）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="4"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="经度" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="5"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_LON}" />
                                            </Border>

                                            <!--  纬度（ADIF: MY_LAT）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="6"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="纬度" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="7"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_LAT}" />
                                            </Border>

                                            <!--  邮政编码（ADIF: MY_POSTAL_CODE）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="8"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="邮政编码" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="9"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_POSTAL_CODE}" />
                                            </Border>

                                            <!--  ══════════════ 第 3 行：Excel 中为 A3:J3 整行合并的空行，作分组间距用，不放控件 ══════════════  -->

                                            <!--  ══════════════ 第 4 行 ══════════════  -->

                                            <!--  台站地址（ADIF: MY_STREET，本站街道地址；标签占 A:B，输入框占 C:E）  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="台站地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_STREET}" />
                                            </Border>

                                            <!--  通讯地址（项目自定义，ADIF 无对应本站字段；标签占 F:G，输入框占 H:J）  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="通讯地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_MailAddress}" />
                                            </Border>

                                            <!--  ══════════════ 第 5 行 ══════════════  -->

                                            <!--  QSL邮寄地址（项目自定义，ADIF 无对应本站字段）  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="QSL邮寄地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_QslAddress}" />
                                            </Border>

                                            <!--  电子邮箱（项目自定义；ADIF 的 EMAIL 指对方邮箱，不能复用）  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="电子邮箱" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_Email}" />
                                            </Border>

                                            <!--  ══════════════ 第 6 行 ══════════════  -->

                                            <!--  常用天线（ADIF: MY_ANTENNA）  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="常用天线" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_ANTENNA}" />
                                            </Border>

                                            <!--  常用设备（ADIF: MY_RIG）  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="常用设备" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_RIG}" />
                                            </Border>



                                        </Grid>



                                    </Border>
                                </Grid>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1">
                            <!--  放弃界面上的修改，重新从数据库读取设置填入界面  -->
                            <Button
                                Command="{Binding CancelSettingsChangeCommand}"
                                Content="取消更改"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Border>
                        <Border Grid.Column="2">
                            <!--  重置界面为默认值（只改界面，需再点保存才写库）  -->
                            <Button
                                Command="{Binding ResetSettingsCommand}"
                                Content="恢复到默认设置"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Border>
                        <Border Grid.Column="3">
                            <!--  把界面上的设置写入数据库（首次插入，之后覆盖）  -->
                            <Button
                                Command="{Binding SaveSettingsCommand}"
                                Content="保存设置"
                                Style="{StaticResource InOptionButtonStyle}" />
                        </Border>
                    </Grid>
                </Border>

            </Grid>

        </TabItem>
    </TabControl>
</Window>
