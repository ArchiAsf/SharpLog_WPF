<Window
    x:Class="SharpLog.MainLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SharpLog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SharpLog"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    Style="{StaticResource LogMainWindowStyle}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <TabControl Style="{StaticResource DarkTabControlStyle}">
        <TabItem Header="日志编辑" Style="{StaticResource DarkTabItemStyle}">
            <Border Margin="0" Style="{StaticResource CardPanelStyle}">
                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="111*" />
                        <ColumnDefinition Width="69*" />
                        <ColumnDefinition Width="37*" />
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="226*" />
                        <ColumnDefinition Width="497*" />
                        <ColumnDefinition Width="409*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="9*" />
                        <RowDefinition Height="0.75*" />
                    </Grid.RowDefinitions>

                    <!--  顶部工具栏容器  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="7"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button
                                    Width="36"
                                    Margin="2"
                                    Command="{Binding TestAddLogBtnClickCommand}"
                                    Content="T"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>

                        </Grid>


                    </Border>

                    <!--  中间右侧容器  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="6"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsControl x:Name="QsoItemsControl" ItemsSource="{Binding QsoLogCollection}">
                                <!--  布局面板：动态项排列方式  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--  可选：垂直排列StackPanel / 自适应WrapPanel / Grid  -->
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!--  项外边距，卡片之间间距  -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,8" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>


                    <!--  中间通联日志保存区  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="6">
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="204" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="4*" />
                            </Grid.RowDefinitions>

                            <!--  左侧第一列栏  -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">

                                <!--  左侧栏划分表格  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" />
                                        <RowDefinition Height="180" />
                                        <RowDefinition Height="3.25*" />
                                    </Grid.RowDefinitions>

                                    <!--  时间显示区实现  -->
                                    <Border Style="{StaticResource CardPanelStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7.5*" />
                                                <RowDefinition Height="2.5*" />
                                            </Grid.RowDefinitions>
                                            <!--  上方时间区  -->
                                            <Border BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>


                                                    <!--  UTC时间区  -->
                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        BorderBrush="{StaticResource PanelBorderColor}"
                                                        BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="1.5*" />
                                                                <RowDefinition Height="3*" />
                                                                <RowDefinition Height="1*" />
                                                            </Grid.RowDefinitions>

                                                            <Border
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Label Style="{StaticResource TimeLabelStyle}">
                                                                    <TextBlock>
                                                                        UTC时间
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Border Style="{StaticResource TimeBorder}">
                                                                    <Label Style="{StaticResource TimeStyle}">
                                                                        <TextBlock TextAlignment="Center">
                                                                            03:29:36
                                                                        </TextBlock>
                                                                    </Label>
                                                                </Border>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Padding="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom">
                                                                <Label Style="{StaticResource UTCZoneStyle}">
                                                                    <TextBlock>
                                                                        UTC+0
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Label Style="{StaticResource TimeDataStyle}">
                                                                    <TextBlock>
                                                                        2026/07/25
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>

                                                        </Grid>
                                                    </Border>

                                                    <!--  地区时间区  -->
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        BorderBrush="{StaticResource PanelBorderColor}"
                                                        BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="1.5*" />
                                                                <RowDefinition Height="3*" />
                                                                <RowDefinition Height="1*" />
                                                            </Grid.RowDefinitions>

                                                            <Border
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Label Style="{StaticResource TimeLabelStyle}">
                                                                    <TextBlock>
                                                                        北京时间
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Border Style="{StaticResource TimeBorder}">
                                                                    <Label Style="{StaticResource TimeStyle}">
                                                                        <TextBlock TextAlignment="Center">
                                                                            11:29:36
                                                                        </TextBlock>
                                                                    </Label>
                                                                </Border>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Padding="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom">
                                                                <Label Style="{StaticResource UTCZoneStyle}">
                                                                    <TextBlock>
                                                                        UTC+8
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>

                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Padding="0">
                                                                <Label Style="{StaticResource TimeDataStyle}">
                                                                    <TextBlock>
                                                                        2026/07/25
                                                                    </TextBlock>
                                                                </Label>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                </Grid>
                                            </Border>

                                            <!--  晨昏显示区  -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="3.5*" />
                                                    <ColumnDefinition Width="3.5*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="7*" />
                                                    <RowDefinition Height="5.5*" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="0"
                                                    BorderBrush="{StaticResource PanelBorderColor}"
                                                    BorderThickness="0,0,1,0">

                                                    <Image Margin="2" Source="/logo/Dusk.png" />
                                                </Border>

                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    BorderBrush="{StaticResource PanelBorderColor}"
                                                    BorderThickness="0,0,0,1">
                                                    <StackPanel
                                                        Margin="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Label
                                                            Margin="0,0,8,0"
                                                            Padding="0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                当前时刻为:
                                                            </TextBlock>
                                                        </Label>
                                                        <Label
                                                            Margin="1,0"
                                                            Padding="0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                黄昏
                                                            </TextBlock>
                                                        </Label>
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    BorderBrush="{StaticResource PanelBorderColor}"
                                                    BorderThickness="0,0,1,0">
                                                    <StackPanel
                                                        Margin="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Label
                                                            Margin="0,0,4,0"
                                                            Padding="0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                日出:
                                                            </TextBlock>
                                                        </Label>
                                                        <Label
                                                            Padding="0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                04：07
                                                            </TextBlock>
                                                        </Label>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Row="1" Grid.Column="2">
                                                    <StackPanel
                                                        Margin="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Label
                                                            Margin="0,0,4,0"
                                                            Padding="0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                日落:
                                                            </TextBlock>
                                                        </Label>
                                                        <Label
                                                            Padding="0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource LabelMainTitleColor}">
                                                            <TextBlock>
                                                                19：27
                                                            </TextBlock>
                                                        </Label>
                                                    </StackPanel>
                                                </Border>




                                            </Grid>

                                        </Grid>
                                    </Border>

                                    <!--  小日历组件，点选录入日期  -->
                                    <Border
                                        Grid.Row="1"
                                        Padding="0"
                                        Style="{StaticResource CardPanelStyle}" />

                                </Grid>
                            </Border>

                            <!--  中间主要栏  -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Style="{StaticResource CardPanelStyle}">
                                <Grid Grid.RowSpan="2" Grid.Column="1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：开始时间 StartTime  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                ·开始时间<LineBreak />
                                                StartTime</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  开始时间输入框  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <hc:DateTimePicker SelectedDateTime="{Binding startTime, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：结束时间 EndTime  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                ·结束时间<LineBreak />
                                                EndTime</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  结束时间输入框  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <hc:DateTimePicker SelectedDateTime="{Binding endTime, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：备注 RMKS  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                备注<LineBreak />
                                                RMKS</TextBlock>
                                        </Label>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：呼号 CallSign  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                ·呼号<LineBreak />
                                                CallSign</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  呼号输入框  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="CallSignInPutBox"
                                            FontFamily="Consolas"
                                            FontSize="22"
                                            Foreground="{StaticResource AccentTextColor}"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding CallSign, Mode=TwoWay}" />
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：模式 Mode  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                ·模式<LineBreak />
                                                Mode</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  模式输入框  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <ComboBox
                                            VerticalAlignment="Center"
                                            Background="{StaticResource NormalTextBoxBackColor}"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding CommModeList}"
                                            SelectedItem="{Binding SelectCommMode}" />

                                    </Border>

                                    <!--  备注多行输入框（纵向跨6行，右侧大区域）  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.RowSpan="7"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RmksInPutBox"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            FontSize="14"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Rmks, Mode=TwoWay}"
                                            TextAlignment="Justify"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：频率 Freq  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                ·频率<LineBreak />
                                                Freq</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  频率输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="FreqInPutBox"
                                            Style="{StaticResource UnitTextBoxStyle}"
                                            Tag="kHz"
                                            Text="{Binding Freq, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：信号报告_收 RST  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                信号报告_收<LineBreak />
                                                RST</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  接收信号报告输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RstInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Rst, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：信号报告_发 RRST  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                信号报告_发<LineBreak />
                                                RRST</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  发射信号报告输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RrstInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Rrst, Mode=TwoWay}" />
                                    </Border>


                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：网格 GRID  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                网格<LineBreak />
                                                Grid</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  网格输入框  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="GridInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding GridLocator, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：发射功率_收 Power  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                发射功率_收<LineBreak />
                                                Power</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  接收功率输入框  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="1"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RxPowerInPutBox"
                                            Style="{StaticResource UnitTextBoxStyle}"
                                            Tag="W"
                                            Text="{Binding RxPower, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：发射功率_发 Power  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                发射功率_发<LineBreak />
                                                Power</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  发射功率输入框  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="5"
                                        Grid.ColumnSpan="1"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="TxPowerInPutBox"
                                            Style="{StaticResource UnitTextBoxStyle}"
                                            Tag="W"
                                            Text="{Binding TxPower, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：地理位置 QTH  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                地理位置<LineBreak />
                                                QTH</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  QTH地理位置输入框  -->
                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="QthInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Qth, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：设备 RIG  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                设备<LineBreak />
                                                RIG</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  设备RIG输入框  -->
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RigInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Rig, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：天线 ANT  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                天线<LineBreak />
                                                ANT</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  天线ANT输入框  -->
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="AntInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Ant, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：发射高度 Height  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                发射高度<LineBreak />
                                                Height</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  发射高度 Height输入框  -->
                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="HeightInPutBox"
                                            Style="{StaticResource UnitTextBoxStyle}"
                                            Tag="M"
                                            Text="{Binding Height, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="3"
                                        Style="{StaticResource CardPanelStyle}">

                                        <!--  字段标签：操作员OP  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                操作员<LineBreak />
                                                OP</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  操作员OP输入框  -->
                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="OPInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding Operator, Mode=TwoWay}" />
                                    </Border>




                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：通联方式  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                通联方式<LineBreak />
                                                PROPMode</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  通联方式 Propagation Mode输入框  -->
                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">

                                        <ComboBox
                                            VerticalAlignment="Center"
                                            Background="{StaticResource NormalTextBoxBackColor}"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding PropagationModeList}"
                                            SelectedItem="{Binding SelectPROPItem}" />

                                    </Border>

                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="3"
                                        Style="{StaticResource CardPanelStyle}">

                                        <!--  字段标签：DMRID  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                数字ID<LineBreak />
                                                DigID</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  DMRID输入框  -->
                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="DMRIDInPutBox"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            Text="{Binding DmrId, Mode=TwoWay}" />
                                    </Border>

                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <Button
                                            Command="{Binding AddLogBtnClickCommand}"
                                            Content="添加日志"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </Border>


                                </Grid>
                            </Border>


                            <!--  中间下方栏  -->
                            <!--  这里我想实现一个输入呼号后通过解析呼号能得出对方的国家后显示国旗图标然后还有国家名字，还有对应呼号的字母解释法，生成界面代码即可不用对应的功能实现代码  -->
                            <TabControl
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InDarkTabControlStyle}">
                                <TabItem
                                    Height="18"
                                    Header="日志信息"
                                    Style="{StaticResource InDarkTabItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="4*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <Border BorderBrush="{StaticResource TabBorderBrush}" BorderThickness="0,0,1,0" />
                                    </Grid>
                                </TabItem>

                                <TabItem Height="18" Style="{StaticResource InDarkTabItemStyle}" />
                            </TabControl>







                        </Grid>
                    </Border>


                    <!--  底部容器  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        
                        
                    </Border>




                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="日志查看" Style="{StaticResource DarkTabItemStyle}">
            <Border Margin="0" Style="{StaticResource CardPanelStyle}" />
        </TabItem>
    </TabControl>
</Window>
