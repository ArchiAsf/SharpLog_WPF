<Window
    x:Class="SharpLog.MainLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SharpLog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:conv="clr-namespace:SharpLog.View.Converters"
    Title="SharpLog"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    Closing="ClosingChange"
    Style="{StaticResource LogMainWindowStyle}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <!--
      日志查看表格用到的值转换器。
      数据库实体里存的是 ADIF 标准原始值（频率存 kHz、模式存主模式代码、
      时间存 HHmmss 不带冒号……），不能直接显示给用户看，需要这几只转换器
      在绑定时把它们变成可读的写法。实现见 View\Converters\LogViewConverters.cs
    -->
    <Window.Resources>
        <conv:FreqToBandConverter x:Key="FreqToBand" />
        <conv:ModeDisplayConverter x:Key="ModeDisplay" />
        <conv:PropModeDisplayConverter x:Key="PropModeDisplay" />
        <conv:TimeDisplayConverter x:Key="TimeDisplay" />
        <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />

        <!--
          左侧两块视图二选一，见 MainLogWindow_VM.Query.cs：
            IsLogListMode=true     → 日志列表（手工定义的那套列）
            IsSqlResultMode=true   → SQL 查询结果（列由结果动态生成）
          用 WPF 内置的布尔转可见性转换器，不必自己写一个。
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <TabControl Style="{StaticResource DarkTabControlStyle}">
        <TabItem Header="日志编辑" Style="{StaticResource DarkTabItemStyle}">
                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition
                            Width="780*"
                            MinWidth="780"
                            MaxWidth="15000" />
                        <ColumnDefinition
                            Width="103*"
                            MinWidth="360"
                            MaxWidth="600" />
                        <ColumnDefinition Width="273*" />

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition MinHeight="380" MaxHeight="600" />
                        <RowDefinition MinHeight="200" MaxHeight="100000000" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <!--  顶部工具栏容器  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                        </Grid>


                    </Border>

                    <!--  中左侧第小工具一列栏  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">

                        <!--  左侧栏划分表格  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="220" />
                                <RowDefinition Height="180" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  时间显示区实现  -->
                            <Border Style="{StaticResource CardPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="7.5*" />
                                        <RowDefinition Height="2.5*" />
                                        <RowDefinition Height="2.0*" />
                                    </Grid.RowDefinitions>
                                    <!--  上方时间区  -->
                                    <Border BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>


                                            <!--  UTC时间区  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1.5*" />
                                                        <RowDefinition Height="3*" />
                                                        <RowDefinition Height="1*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeLabelStyle}">
                                                            <TextBlock>
                                                                UTC时间
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Border Style="{StaticResource TimeBorder}">
                                                            <Label Style="{StaticResource TimeStyle}">
                                                                <TextBlock Text="{Binding UtcTime}" TextAlignment="Center" />
                                                            </Label>
                                                        </Border>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="3,0,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                        <Label Style="{StaticResource UTCZoneStyle}">
                                                            <TextBlock Text="{Binding UtcTimeZone}">
                                                                UTC
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeDataStyle}">
                                                            <TextBlock Text="{Binding UtcDate}" />
                                                        </Label>
                                                    </Border>

                                                </Grid>
                                            </Border>

                                            <!--  地区时间区  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1.5*" />
                                                        <RowDefinition Height="3*" />
                                                        <RowDefinition Height="1*" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeLabelStyle}">
                                                            <TextBlock>
                                                                时区时间
                                                            </TextBlock>
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Border Style="{StaticResource TimeBorder}">
                                                            <Label Style="{StaticResource TimeStyle}">
                                                                <TextBlock Text="{Binding LocalTime}" TextAlignment="Center" />
                                                            </Label>
                                                        </Border>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Margin="3,0,0,0"
                                                        Padding="0,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                        <Label Style="{StaticResource UTCZoneStyle}">
                                                            <TextBlock Text="{Binding LocalTimeZone}" />
                                                        </Label>
                                                    </Border>

                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Padding="0">
                                                        <Label Style="{StaticResource TimeDataStyle}">
                                                            <TextBlock Text="{Binding LocalDate}" />
                                                        </Label>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <!--  晨昏显示区  -->
                                    <Border
                                        Grid.Row="1"
                                        BorderBrush="{StaticResource PanelBorderColor}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="3.5*" />
                                                <ColumnDefinition Width="3.5*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="7*" />
                                                <RowDefinition Height="5.5*" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,1,0">

                                                <!--  时段图标：随 黎明/日间/黄昏/夜间 自动切换（图片在 logo 目录下）  -->
                                                <Image Margin="2" Source="{Binding DayPeriodIconPath}" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,0,1">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,8,0"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource TimeLabelStyle}">
                                                        <TextBlock>
                                                            当前时刻为:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Margin="1,0"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  时段文字：与左侧图标同步切换  -->
                                                        <TextBlock Text="{Binding DayPeriodText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                BorderBrush="{StaticResource PanelBorderColor}"
                                                BorderThickness="0,0,1,0">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <TextBlock>
                                                            日出:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  日出时刻：由 VM 每天零点重算（民用晨昏）  -->
                                                        <TextBlock Text="{Binding SunriseText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1" Grid.Column="2">
                                                <StackPanel
                                                    Margin="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <TextBlock>
                                                            日落:
                                                        </TextBlock>
                                                    </Label>
                                                    <Label
                                                        Padding="0"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LabelMainTitleColor}"
                                                        Style="{StaticResource LabelMainTitleStyle}">
                                                        <!--  日落时刻：由 VM 每天零点重算（民用晨昏）  -->
                                                        <TextBlock Text="{Binding SunsetText}" />
                                                    </Label>
                                                </StackPanel>
                                            </Border>




                                        </Grid>
                                    </Border>

                                    <!--  转换时区按钮  -->
                                    <Border Grid.Row="2">
                                        <Button
                                            Margin="5"
                                            Command="{Binding ConvertTimeZoneCommand}"
                                            Content="时区转换"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    </Border>

                                </Grid>
                            </Border>



                        </Grid>
                    </Border>

                    <!--  中间主要日志填写栏  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <Grid Grid.RowSpan="2" Grid.Column="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding StartTimeTextClick_TimeInPutStartTimeCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <!--  字段标签：开始时间（复合输入，后台拆分存储为 QSO_DATE + TIME_ON）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·开始时间" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  开始时间输入框（hc:DateTimePicker 复合输入，后台拆分存储）  -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <hc:DateTimePicker SelectedDateTime="{Binding StartTimeDT, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding EndTimeTextClick_TimeInPutEndTimeCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <!--  字段标签：结束时间（复合输入，后台拆分存储为 QSO_DATE_OFF + TIME_OFF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·结束时间" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  结束时间输入框（hc:DateTimePicker 复合输入，后台拆分存储）  -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <hc:DateTimePicker SelectedDateTime="{Binding EndTimeDT, Mode=TwoWay}" Style="{StaticResource TimeInPut_HC}" />

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：备注 COMMENT（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="备注" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：呼号 CALL（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·呼号" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  呼号输入框（ADIF: CALL）  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="CALLInPutBox"
                                    FontFamily="Consolas"
                                    FontSize="22"
                                    Foreground="{StaticResource AccentTextColor}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding CALL, Mode=TwoWay}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：模式 Mode  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·模式" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  模式输入框  -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <!--
                                    通联模式下拉框。
                                    DisplayMemberPath 指向 ModeItem.DisplayName（界面显示名，
                                    如 "D-STAR"），而不是 Mode（ADIF 主模式 "DIGITALVOICE"），
                                    这样用户看到的是自己熟悉的模式名。
                                    选中项由 SelectedItem 绑定（不用 SelectedValue）。
                                -->
                                <ComboBox
                                    Background="{StaticResource NormalTextBoxBackColor}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding CommModeList}"
                                    SelectedItem="{Binding SelectCommMode}" />

                            </Border>

                            <!--  备注多行输入框（ADIF: COMMENT，纵向跨6行，右侧大区域）  -->
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="7"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="COMMENTInPutBox"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    FontSize="14"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding COMMENT, Mode=TwoWay}"
                                    TextAlignment="Justify"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：频率 FREQ（ADIF，单位kHz）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="·频率" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  频率输入框（ADIF: FREQ，kHz）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="FREQInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="kHz"
                                    Text="{Binding FREQ, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：信号报告_收 RST_RCVD（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="信号报告_收" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  接收信号报告输入框（ADIF: RST_RCVD）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="3"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RST_RCVDInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RST_RCVD, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：信号报告_发 RST_SENT（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="信号报告_发" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射信号报告输入框（ADIF: RST_SENT）  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RST_SENTInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RST_SENT, Mode=TwoWay}" />
                            </Border>


                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：网格 GRIDSQUARE（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="网格" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  网格输入框（ADIF: GRIDSQUARE）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="GRIDSQUAREInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding GRIDSQUARE, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射功率_收 RX_PWR（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射功率_收" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  接收功率输入框（ADIF: RX_PWR）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="3"
                                Grid.ColumnSpan="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RX_PWRInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="W"
                                    Text="{Binding RX_PWR, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="4"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射功率_发 TX_PWR（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射功率_发" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射功率输入框（ADIF: TX_PWR）  -->
                            <Border
                                Grid.Row="3"
                                Grid.Column="5"
                                Grid.ColumnSpan="1"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="TX_PWRInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="W"
                                    Text="{Binding TX_PWR, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：地理位置 QTH  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="地理位置" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  QTH地理位置输入框（ADIF: QTH）  -->
                            <Border
                                Grid.Row="4"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="QTHInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding QTH, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：设备 RIG  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="设备" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  设备RIG输入框（ADIF: RIG）  -->
                            <Border
                                Grid.Row="5"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="RIGInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding RIG, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：天线 ANT  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="天线" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  天线ANT输入框  -->
                            <Border
                                Grid.Row="6"
                                Grid.Column="1"
                                Grid.ColumnSpan="5"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="AntInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding Ant, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：发射高度 Height  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="发射高度" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  发射高度 Height输入框  -->
                            <Border
                                Grid.Row="7"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="HeightInPutBox"
                                    Style="{StaticResource UnitTextBoxStyle}"
                                    Tag="M"
                                    Text="{Binding Height, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="7"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">

                                <!--  字段标签：对方值机员 CONTACTED_OP（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="值机员" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--
                                对方电台值机员输入框（指对方实际操作的台）
                                ⚠ 与「本站操作员」不同：本站呼号来自设置页的 STATION_CALLSIGN
                            -->
                            <Border
                                Grid.Row="7"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding CONTACTED_OP, Mode=TwoWay}" />
                            </Border>




                            <Border
                                Grid.Row="8"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}">
                                <!--  字段标签：传播模式 PROP_MODE（ADIF）  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="传播模式" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  传播模式 Propagation Mode输入框  -->
                            <Border
                                Grid.Row="8"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">

                                <!--
                                    传播模式下拉框。
                                    DisplayMemberPath 指向 PropagationItem.DisplayName
                                    （格式为「中文 + 代码」，如 "F2层反射 F2"）。
                                    选中首项「（不指定）」时 Code 为 null，
                                    存库时 QsoLog.PROP_MODE 写 NULL。
                                -->
                                <ComboBox
                                    Background="{StaticResource NormalTextBoxBackColor}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding PropagationModeList}"
                                    SelectedItem="{Binding SelectPROPItem}" />

                            </Border>

                            <Border
                                Grid.Row="8"
                                Grid.Column="3"
                                Style="{StaticResource CardPanelStyle}">

                                <!--  字段标签：DMRID  -->
                                <Label
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelMainTitleStyle}">
                                    <TextBlock Text="数字ID" TextAlignment="Center" />
                                </Label>
                            </Border>
                            <!--  DMRID输入框  -->
                            <Border
                                Grid.Row="8"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <TextBox
                                    x:Name="DMRIDInPutBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    Text="{Binding DigID, Mode=TwoWay}" />
                            </Border>

                            <Border
                                Grid.Row="8"
                                Grid.Column="6"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource InCardPanelStyle}">
                                <Button
                                    Command="{Binding AddLogBtnClickCommand}"
                                    Content="添加日志"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </Border>


                        </Grid>
                    </Border>

                    <!--  中间下方栏  -->
                    <!--  这里我想实现一个输入呼号后通过解析呼号能得出对方的国家后显示国旗图标然后还有国家名字，还有对应呼号的字母解释法，生成界面代码即可不用对应的功能实现代码  -->
                    <TabControl
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="2,2,2,2"
                        Style="{StaticResource InDarkTabControlStyle}">
                        <TabItem
                            Height="18"
                            Header="其他信息"
                            Style="{StaticResource InDarkTabItemStyle}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>


                                <Border BorderBrush="{StaticResource TabBorderBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                                        VerticalScrollBarVisibility="Visible">
                                        <Border />
                                    </ScrollViewer>
                                </Border>

                                <ScrollViewer
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                                    VerticalScrollBarVisibility="Visible">
                                    <!--  日志其他信息区  -->
                                    <Border Height="240" Padding="0,0,1.5,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>

                                            <!--  ====================== 第0行：分组、星标数字输入区域 ======================  -->
                                            <!--  分组 文字标签容器  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <!--  使用动态资源实现多语言文本  -->
                                                    <TextBlock Text="{DynamicResource Text_Group}" />
                                                </Label>
                                            </Border>

                                            <!--  分组数值输入框，hc数字增减控件  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="0,2,0,2">
                                                <hc:NumericUpDown
                                                    FontSize="16"
                                                    Maximum="5"
                                                    Minimum="0"
                                                    Value="{Binding GroupID}" />
                                            </Border>

                                            <!--  星标 文字标签容器  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_Star}" />
                                                </Label>
                                            </Border>

                                            <!--  星标等级数值输入框  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:NumericUpDown
                                                    FontSize="16"
                                                    Maximum="5"
                                                    Minimum="0"
                                                    Value="{Binding StarID}" />
                                            </Border>

                                            <!--  ====================== 第1行：是否已收妥QSL卡片下拉选择 ======================  -->
                                            <!--  标签，横跨0、1、2三列  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslReceived}" />
                                                </Label>
                                            </Border>

                                            <!--  下拉选择框：是 / 否（ADIF: QSL_RCVD）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:ComboBox Text="{Binding QSL_RCVD}">
                                                    <hc:ComboBox.Items>
                                                        <system:String>是</system:String>
                                                        <system:String>否</system:String>
                                                    </hc:ComboBox.Items>
                                                </hc:ComboBox>
                                            </Border>

                                            <!--  ====================== 第2行：QSL收发日期选择区域 ======================  -->
                                            <!--  QSL卡收到时间 标签  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslReceiveTime}" />
                                                </Label>
                                            </Border>

                                            <!--  QSL收到日期选择器（ADIF: QSLRDATE）  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Padding="0,2,0,2">
                                                <hc:DatePicker SelectedDate="{Binding QSLRDATE}" />
                                            </Border>

                                            <!--  QSL卡发出时间 标签  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslSendTime}" />
                                                </Label>
                                            </Border>

                                            <!--  QSL发出日期选择器（ADIF: QSLSDATE）  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Padding="0,2,0,2">
                                                <hc:DatePicker SelectedDate="{Binding QSLSDATE}" />
                                            </Border>

                                            <!--  ====================== 第3行：QSL卡片邮寄地址标题 ======================  -->
                                            <!--  标签横跨全部4列  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_QslMailAddress}" />
                                                </Label>
                                            </Border>

                                            <!--  ====================== 第4行：QSL完整邮寄地址输入框 ======================  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding QslAddress}" />
                                            </Border>

                                            <!--  ====================== 第5行：邮政编码、收件人姓名 ======================  -->
                                            <!--  邮政编码 标签，横跨0、1列  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_PostalCode}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人姓名 标签  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_ReceiverName}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人姓名输入框  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="3"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding ReceiverName}" />
                                            </Border>

                                            <!--  ====================== 第6行：邮政编码输入框、收件人联系方式 ======================  -->
                                            <!--  邮政编码输入框，横跨0、1列  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding PostalCode}" />
                                            </Border>

                                            <!--  收件人联系方式 标签  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="2"
                                                Style="{StaticResource LittleCardPanelStyle}">
                                                <Label Style="{StaticResource LittleLabelStyle}">
                                                    <TextBlock Text="{DynamicResource Text_ReceiverContact}" />
                                                </Label>
                                            </Border>

                                            <!--  收件人联系方式输入框  -->
                                            <Border
                                                Grid.Row="6"
                                                Grid.Column="3"
                                                Padding="2,2,1,2">
                                                <TextBox Text="{Binding ReceiverContact}" />
                                            </Border>


                                            <!--  因为表格空间限制，不得不删除掉气温和天气的填写，后续版本再添加上吧  -->
                                            <!--<Border
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Style="{StaticResource LittleCardPanelStyle}">
                                            <Label Style="{StaticResource LittleLabelStyle}">
                                                <TextBlock Text="{DynamicResource Text_Weather}" />
                                            </Label>
                                        </Border>

                                        <Border
                                            Grid.Row="7"
                                            Grid.Column="2"
                                            Style="{StaticResource LittleCardPanelStyle}">
                                            <Label Style="{StaticResource LittleLabelStyle}">
                                                <TextBlock Text="{DynamicResource Text_Temperature}" />
                                            </Label>
                                        </Border>-->


                                        </Grid>
                                    </Border>
                                </ScrollViewer>

                            </Grid>
                        </TabItem>
                        <TabItem Height="18" Style="{StaticResource InDarkTabItemStyle}" />
                    </TabControl>

                    <!--  右侧日志显示容器  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                            VerticalScrollBarVisibility="Visible">
                            <ItemsControl
                                x:Name="QsoItemsControl"
                                Padding="0,0,1,0"
                                ItemsSource="{Binding QsoLogCollection}">
                                <!--  布局面板：动态项排列方式  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--  可选：垂直排列StackPanel / 自适应WrapPanel / Grid  -->
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!--  项外边距，卡片之间间距  -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,8" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!--  底部容器  -->
                    <Border
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="2,2,2,2"
                        Style="{StaticResource CardPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{DynamicResource Text_NowTimeZone}" />
                                </Label>
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{Binding ZoneName}" />
                                </Label>
                            </StackPanel>

                            <!--
                              ── 值机员（靠右）──
                              绑 OPERATOR（ADIF: OPERATOR）—— 本次通联时在电台前操作的人。
                              ⚠ 与「本站呼号 STATION_CALLSIGN」是两回事：后者指台站本身，
                                前者指操作的人（远征台、集体台换班时两者会不同）。
                            -->
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{DynamicResource Text_RadioOperator}" />
                                </Label>
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{Binding OPERATOR}" />
                                </Label>
                            </StackPanel>

                            <!--  ── 值机员所在网格（靠右）──  -->
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{DynamicResource Text_OperatorGrid}" />
                                </Label>
                                <Label Style="{StaticResource EffectLabelStyle}">
                                    <TextBlock Text="{Binding MY_GRIDSQUARE}" />
                                </Label>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!--  【日志编辑页】的消息提示面板（右下角）  -->
                    <!--  Token 是这个面板的身份标识，MessageTools 靠它把消息发到指定的页  -->
                    <StackPanel
                        Grid.RowSpan="4"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Width="auto"
                        Margin="0,340,5,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        hc:Growl.GrowlParent="True"
                        hc:Growl.ShowMode="Append"
                        hc:Growl.Token="LogEditGrowl" />

                </Grid>

        </TabItem>

        <TabItem Header="日志查看" Style="{StaticResource DarkTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="450" />
                </Grid.ColumnDefinitions>

                <!--  【日志查看页】的消息提示面板（右下角）  -->
                <!--
                  ⚠ 必须放在 RowDefinitions / ColumnDefinitions 这些【属性元素】的【后面】——
                    XAML 规定属性元素既不能在内容元素之后、也不能夹在内容中间，
                    所以内容元素要统统排在所有属性元素之后（否则报 MC3088）。
                  ⚠ Panel.ZIndex 是为了让消息浮在表格之上，否则会被后面声明的 Border 遮住。
                  ⚠ 下边距留 40，是为了避开表格底部那行「加载更多」按钮。
                -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Panel.ZIndex="99"
                    Margin="0,0,5,40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    hc:Growl.GrowlParent="True"
                    hc:Growl.ShowMode="Append"
                    hc:Growl.Token="LogViewGrowl" />
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardPanelStyle}">
                    
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--  表格占满剩余高度  -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                          日志数据表格。
                          · 列由 XAML 手工定义（AutoGenerateColumns=False）：
                            这样表头可以左右拖拽换位（CanUserReorderColumns），
                            自动生成的列在重新绑定时会被重建，顺序就丢了。
                          · 只读：编辑走双击/右键弹出的悬浮窗口，不在这里直接改。
                        -->
                        <!--
                          ══════════ SQL 查询结果（列由结果动态生成）══════════
                          ⚠ 与下面的日志列表【叠在同一位置】，靠可见性二选一。
                          ⚠ AutoGenerateColumns=True：列完全按 SQL 返回的字段来，
                             所以 SELECT COUNT(*) 这种聚合查询也能正常显示。
                          ⚠ 只有【只读查询】会切到这里；写操作（DELETE/UPDATE）执行完
                             走的是 ApplyQuery() 刷新日志列表，不切视图。
                             想切回列表：再执行一次条件查询即可（ApplyQuery 会复位）。
                        -->
                        <DataGrid
                            x:Name="SqlResultDataGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding SqlResultTable}"
                            Style="{StaticResource DarkDataGridStyle}"
                            Visibility="{Binding IsSqlResultMode, Converter={StaticResource BoolToVis}}" />

                        <DataGrid
                            x:Name="LogViewDataGrid"
                            Grid.Row="0"
                            ItemsSource="{Binding LogViewRows}"
                            Visibility="{Binding IsLogListMode, Converter={StaticResource BoolToVis}}"
                            Loaded="LogViewDataGrid_Loaded"
                            ScrollViewer.ScrollChanged="LogViewDataGrid_ScrollChanged"
                            SelectedItem="{Binding SelectedLogViewRow, Mode=TwoWay}"
                            Style="{StaticResource DarkDataGridStyle}">

                            <!--  双击整行 → 打开编辑窗口  -->
                            <DataGrid.InputBindings>
                                <MouseBinding
                                    Command="{Binding OpenLogEditCommand}"
                                    CommandParameter="{Binding SelectedLogViewRow}"
                                    MouseAction="LeftDoubleClick" />
                            </DataGrid.InputBindings>

                            <!--  右键 → 行操作菜单  -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <MenuItem
                                        Command="{Binding OpenLogEditCommand}"
                                        CommandParameter="{Binding SelectedLogViewRow}"
                                        Header="更改该记录"
                                        Style="{StaticResource DarkMenuItemStyle}" />
                                    <MenuItem
                                        Command="{Binding DeleteLogCommand}"
                                        CommandParameter="{Binding SelectedLogViewRow}"
                                        Header="删除该记录"
                                        Style="{StaticResource DarkMenuItemStyle}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <!--  ==================== 最常用的核心字段排在最前 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding Id}"
                                    Header="记录ID&#x0a;(Id)" />
                                <DataGridTextColumn
                                    Binding="{Binding QSO_DATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="日期&#x0a;(QSO_DATE)" />
                                <DataGridTextColumn
                                    Binding="{Binding TIME_ON, Converter={StaticResource TimeDisplay}}"
                                    Header="时间&#x0a;(TIME_ON)" />
                                <DataGridTextColumn
                                    Binding="{Binding CALL}"
                                    Header="呼号&#x0a;(CALL)" />
                                <DataGridTextColumn
                                    Binding="{Binding FREQ}"
                                    Header="频率(kHz)&#x0a;(FREQ)" />
                                <!--  波段不是数据库字段，是由频率查 ADIF 波段表算出来的  -->
                                <DataGridTextColumn
                                    Binding="{Binding FREQ, Converter={StaticResource FreqToBand}}"
                                    Header="波段&#x0a;(由 FREQ 推算)" />
                                <!--
                                  模式由 MODE + SUBMODE 两级反查成界面显示名。
                                  直接显示 MODE 的话，界面选 FT4 的会显示成 MFSK，
                                  选 D-STAR 的会显示成 DIGITALVOICE，用户根本认不出来。
                                -->
                                <DataGridTextColumn Header="模式&#x0a;(MODE)">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource ModeDisplay}">
                                            <Binding Path="MODE" />
                                            <Binding Path="SUBMODE" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding SUBMODE}"
                                    Header="子模式&#x0a;(SUBMODE)" />
                                <DataGridTextColumn
                                    Binding="{Binding RST_SENT}"
                                    Header="信号报告(发)&#x0a;(RST_SENT)" />
                                <DataGridTextColumn
                                    Binding="{Binding RST_RCVD}"
                                    Header="信号报告(收)&#x0a;(RST_RCVD)" />
                                <DataGridTextColumn
                                    Binding="{Binding PROP_MODE, Converter={StaticResource PropModeDisplay}}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="传播模式&#x0a;(PROP_MODE)" />

                                <!--  ==================== 对方电台信息 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding QTH}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="对方城市&#x0a;(QTH)" />
                                <DataGridTextColumn
                                    Binding="{Binding GRIDSQUARE}"
                                    Header="网格定位&#x0a;(GRIDSQUARE)" />
                                <DataGridTextColumn
                                    Binding="{Binding RX_PWR}"
                                    Header="对方功率&#x0a;(RX_PWR)" />
                                <DataGridTextColumn
                                    Binding="{Binding TX_PWR}"
                                    Header="我方功率&#x0a;(TX_PWR)" />
                                <DataGridTextColumn
                                    Binding="{Binding RIG}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="对方设备&#x0a;(RIG)" />
                                <DataGridTextColumn
                                    Binding="{Binding ANT}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="对方天线&#x0a;(ANT)" />
                                <DataGridTextColumn
                                    Binding="{Binding Height}"
                                    Header="天线高度&#x0a;(Height)" />
                                <DataGridTextColumn
                                    Binding="{Binding CONTACTED_OP}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="对方值机员&#x0a;(CONTACTED_OP)" />
                                <DataGridTextColumn
                                    Binding="{Binding RadioOperator}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="本站操作员&#x0a;(RadioOperator)" />

                                <!--  ==================== 通联结束时刻 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding QSO_DATE_OFF, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="结束日期&#x0a;(QSO_DATE_OFF)" />
                                <DataGridTextColumn
                                    Binding="{Binding TIME_OFF, Converter={StaticResource TimeDisplay}}"
                                    Header="结束时间&#x0a;(TIME_OFF)" />
                                <DataGridTextColumn
                                    Binding="{Binding TimeZone}"
                                    Header="时区&#x0a;(TimeZone)" />

                                <!--  ==================== QSL 卡片管理 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding QSL_RCVD, Converter={StaticResource BoolToYesNo}}"
                                    Header="QSL已收&#x0a;(QSL_RCVD)" />
                                <DataGridTextColumn
                                    Binding="{Binding QSLRDATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="收卡日期&#x0a;(QSLRDATE)" />
                                <DataGridTextColumn
                                    Binding="{Binding QSLSDATE, StringFormat={}{0:yyyy-MM-dd}}"
                                    Header="发卡日期&#x0a;(QSLSDATE)" />
                                <DataGridTextColumn
                                    Binding="{Binding QslAddress}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="QSL地址&#x0a;(QslAddress)" />
                                <DataGridTextColumn
                                    Binding="{Binding PostalCode}"
                                    Header="邮政编码&#x0a;(PostalCode)" />
                                <DataGridTextColumn
                                    Binding="{Binding ReceiverName}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="收件人&#x0a;(ReceiverName)" />
                                <DataGridTextColumn
                                    Binding="{Binding ReceiverContact}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="联系方式&#x0a;(ReceiverContact)" />

                                <!--  ==================== 项目自定义字段 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding DigitalID}"
                                    Header="DMR ID&#x0a;(DigitalID)" />
                                <DataGridTextColumn
                                    Binding="{Binding GroupID}"
                                    Header="分组&#x0a;(GroupID)" />
                                <DataGridTextColumn
                                    Binding="{Binding StarID}"
                                    Header="星级&#x0a;(StarID)" />
                                <DataGridTextColumn
                                    Binding="{Binding Weather}"
                                    Header="天气&#x0a;(Weather)" />
                                <DataGridTextColumn
                                    Binding="{Binding Temperature}"
                                    Header="温度&#x0a;(Temperature)" />
                                <DataGridTextColumn
                                    Binding="{Binding IsConfirmed, Converter={StaticResource BoolToYesNo}}"
                                    Header="双向确认&#x0a;(IsConfirmed)" />
                                <DataGridTextColumn
                                    Binding="{Binding COMMENT}"
                                    CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
                                    Header="备注&#x0a;(COMMENT)" />

                                <!--  ==================== 记录元数据 ====================  -->
                                <DataGridTextColumn
                                    Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                    Header="创建时间&#x0a;(CreatedAt)" />
                                <DataGridTextColumn
                                    Binding="{Binding LastUpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                    Header="最后修改&#x0a;(LastUpdatedAt)" />

                            </DataGrid.Columns>
                        </DataGrid>

                        <!--
                          「加载更多」。
                          ⚠ 它放在表格【外面】，而不是塞进表格的最后一行：
                            DataGrid 的单元格不支持跨列合并，想在最后一行显示整句
                            「已加载 N 条，点击继续加载」只能挤在某一列的宽度里，
                            根本显示不全。放在表格正下方既完整可见，又不受横向滚动影响。
                          防连点由 VM 的 IsLoadingMore 负责：加载期间按钮自动禁用。
                        
                        
                        改为了悬浮在右下角
                        -->
                        <Border Style="{StaticResource InCardPanelStyle}" Margin="0,0,10,10" Padding="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Margin="0" Padding="5,2,3,2"
                            Command="{Binding LoadMoreLogViewCommand}"
                            Content="{Binding LoadMoreText}"
                            Style="{StaticResource LoadMoreLinkStyle}" />
                        </Border>

                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPanelStyle}">
                    <!--
                      ══════════════ 右侧：查询 / 筛选 / 统计区 ══════════════
                      （表格在左、查询在右；宽度由外层 Grid 的 列 */450 决定）
                      ⚠ 本区【目前只做界面样式，尚未接底层逻辑】：
                         所有下拉项、统计数字均为静态示例值，
                         控件也都没有绑定 ViewModel，等布局确认后再接数据。
                      ⚠ 三行结构：顶栏(auto) / 查询+筛选(*) / 统计(auto)
                         第三行固定 Auto，所以统计区会【钉在底部】，
                         中间那行无论内容多少都只在自己区域内滚动。
                    -->
                    <Border Style="{StaticResource QueryPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  ① 顶栏：标题 + 清空  -->
                            <Border Grid.Row="0" Style="{StaticResource QueryTitlePanelStyle}">
                                <Grid>
                                    <Label
                                        HorizontalAlignment="Left"
                                        Content="查询与筛选"
                                        Style="{StaticResource QueryTitleStyle}" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{Binding ClearQueryConditionsCommand}"
                                        Content="清空"
                                        Style="{StaticResource QueryMiniButtonStyle}" />
                                </Grid>
                            </Border>

                            <!--  ② 中部：查询条件 + 筛选器（内容超高时本区自行滚动）  -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,0,8,6">

                                    <!--  ── 查询条件 ──  -->
                                    <Label Content="查询条件" Style="{StaticResource QuerySectionLabelStyle}" />
<!--
                                      ── 查询条件行 ──
                                      ⚠ 用 ItemsControl 动态生成：行数由 VM 的 QueryConditions 决定，
                                         默认 1 行，点「+ 添加条件」往集合里加一项就多一行。
                                      ⚠ 横向不扩展（列宽固定），纵向由外层 ScrollViewer 承接。
                                      ⚠ 模板里的 DataContext 是 QueryConditionRow 本身，
                                         要取 VM 上的下拉数据源/命令，必须用 RelativeSource 回到 ItemsControl。
                                    -->
                                    <ItemsControl ItemsSource="{Binding QueryConditions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        Grid.Column="0"
                                                        Height="24"
                                                        DisplayMemberPath="DisplayName"
                                                        FontSize="12"
                                                        ItemsSource="{Binding DataContext.QueryFieldOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        SelectedItem="{Binding SelectedField, Mode=TwoWay}" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Height="24"
                                                        Margin="2,0,0,0"
                                                        DisplayMemberPath="DisplayName"
                                                        FontSize="12"
                                                        ItemsSource="{Binding DataContext.QueryOperatorOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        SelectedItem="{Binding SelectedOperator, Mode=TwoWay}" />
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Margin="2,0,0,0"
                                                        Style="{StaticResource QueryInputTextBoxStyle}"
                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button
                                                        Grid.Column="3"
                                                        Command="{Binding DataContext.RemoveQueryConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        Style="{StaticResource QueryMiniButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button
                                        Command="{Binding AddQueryConditionCommand}"
                                        Content="+ 添加条件"
                                        Style="{StaticResource QueryAddButtonStyle}" />


                                    <!--  ── 分隔线 ──  -->
                                    <hc:Divider
                                        Margin="0,8,0,0"
                                        LineStroke="{StaticResource DividerColor}" />

                                    <!--  ── 筛选器 ──  -->
                                    <Label Content="筛选器" Style="{StaticResource QuerySectionLabelStyle}" />

                                    <!--  筛选：按呼号  -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="呼号" Style="{StaticResource QueryFieldLabelStyle}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            FontSize="12"
                                            IsEditable="True"
                                            Text="{Binding FilterCall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!--  筛选：按模式  -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="模式" Style="{StaticResource QueryFieldLabelStyle}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            FontSize="12"
                                            ItemsSource="{Binding FilterModeOptions}"
                                            SelectedItem="{Binding FilterMode, Mode=TwoWay}" />
                                    </Grid>

                                    <!--  筛选：按波段  -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="波段" Style="{StaticResource QueryFieldLabelStyle}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            FontSize="12"
                                            ItemsSource="{Binding FilterBandOptions}"
                                            SelectedItem="{Binding FilterBand, Mode=TwoWay}" />
                                    </Grid>

                                    <!--  快捷开关  -->
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <CheckBox
                                            Content="只看已确认 QSL"
                                            FontSize="12"
                                            IsChecked="{Binding FilterOnlyConfirmed, Mode=TwoWay}" />
                                        <CheckBox
                                            Margin="12,0,0,0"
                                            Content="只看今天"
                                            FontSize="12"
                                            IsChecked="{Binding FilterOnlyToday, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!--  ── 分隔线 ──  -->
                                    <hc:Divider Margin="0,8,0,0" LineStroke="{StaticResource DividerColor}" />

                                    <!--
                                      ── SQL 自由查询 ──
                                      ⚠ 按「只读」设计：提示文字明示仅支持 SELECT。
                                         底层实现时【必须】做三件事，否则这个框很危险：
                                           ① 校验语句首关键字，非 SELECT 一律拒绝
                                             （否则一条 DELETE 就能清空日志表，
                                               本项目没有备份、也没有权限隔离）；
                                           ② 强制追加行数上限（如 LIMIT 500），
                                             防止 SELECT * 自连接把内存吃满、UI 冻住；
                                           ③ 设置命令超时（如 5 秒）。
                                    -->
                                    <Label Content="SQL 自由查询" Style="{StaticResource QuerySectionLabelStyle}" />
                                    <TextBox
                                        Height="84"
                                        HorizontalScrollBarVisibility="Auto"
                                        Style="{StaticResource QuerySqlBoxStyle}"
                                        Text="{Binding SqlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Content="⚠ 筛选器始终生效；非 SELECT 语句需二次确认"
                                            Style="{StaticResource QuerySqlHintStyle}" />
                                        <!--
                                          ── 执行查询（唯一的查询按钮）──
                                          ⚠ 条件查询与 SQL 自由查询已合并到它身上，判定规则见 VM 的 ExecuteQuery：
                                             SQL 框有内容优先跑 SQL；SQL 空且条件也空则提示；否则跑条件查询。
                                        -->
                                        <Button
                                            Grid.Column="1"
                                            Width="110"
                                            Height="30"
                                            Command="{Binding ExecuteQueryCommand}"
                                            Content="执行查询"
                                            FontSize="13"
                                            Style="{StaticResource QueryAddButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!--  ③ 统计区：钉在底部（Grid.Row=2 是 Auto，不参与中间行的滚动）  -->
                            <Border
                                Grid.Row="2"
                                BorderThickness="0,1,0,0"
                                Style="{StaticResource QueryTitlePanelStyle}">
                                <StackPanel Margin="8,5,8,4">

                                    <!--  QSO 总数  -->
                                    <Grid Margin="0,0,0,4">
                                        <Label
                                            HorizontalAlignment="Left"
                                            Content="QSO 总数"
                                            Style="{StaticResource QueryStatCaptionStyle}" />
                                        <Label
                                            HorizontalAlignment="Right"
                                            Content="{Binding QsoTotalCount}"
                                            Style="{StaticResource QueryStatNumberStyle}" />
                                    </Grid>

                                    <!--
                                      CQ / ITU / DXCC 三个分区的通联数。
                                      ⚠ 数字是占位示例值 —— QsoLog 实体里目前【没有】
                                         这三个字段，呼号解析（DXCC/分区）也还没实现，
                                         数据来源待定。
                                    -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource QueryStatCellStyle}">
                                            <StackPanel>
                                                <Label Content="{Binding CqZoneCount}" Style="{StaticResource QueryStatNumberStyle}" />
                                                <Label Content="CQ 分区" Style="{StaticResource QueryStatCaptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource QueryStatCellStyle}">
                                            <StackPanel>
                                                <Label Content="{Binding ItuZoneCount}" Style="{StaticResource QueryStatNumberStyle}" />
                                                <Label Content="ITU 分区" Style="{StaticResource QueryStatCaptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource QueryStatCellStyle}">
                                            <StackPanel>
                                                <Label Content="{Binding DxccCount}" Style="{StaticResource QueryStatNumberStyle}" />
                                                <Label Content="DXCC" Style="{StaticResource QueryStatCaptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>


                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="设置" Style="{StaticResource DarkTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>

                <!--  【设置页】的消息提示面板（右下角）  -->
                <!--
                  放在第 0 行（内容区）里，正好落在底部那条 45 高的按钮栏上方。
                  ⚠ 必须放在 RowDefinitions 之后，原因同「日志查看」页。
                -->
                <StackPanel
                    Grid.Row="0"
                    Panel.ZIndex="99"
                    Margin="0,0,5,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    hc:Growl.GrowlParent="True"
                    hc:Growl.ShowMode="Append"
                    hc:Growl.Token="SettingGrowl" />
                <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}">
                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        Style="{StaticResource DarkOnlyVerticalScrollViewerStyle}"
                        VerticalScrollBarVisibility="Visible">
                        <StackPanel>
                            <Border Style="{StaticResource OptionCardPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*" />
                                        <RowDefinition Height="8*" />
                                    </Grid.RowDefinitions>
                                    <!--  标题  -->
                                    <Border Grid.Row="0" Style="{StaticResource OptionCardTitilePanelStyle}">
                                        <hc:Divider
                                            Margin="-1,0,-1,0"
                                            VerticalAlignment="Top"
                                            Content="本地台站设置"
                                            Style="{StaticResource OptionDividerStyle}" />
                                    </Border>
                                    <!--  选项区  -->
                                    <Border Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>

                                            <!--  ══════════════ 第 1 行 ══════════════  -->

                                            <!--  呼号（ADIF: STATION_CALLSIGN，本站呼号）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="呼号" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding STATION_CALLSIGN}" />
                                            </Border>

                                            <!--  值班员（ADIF: OPERATOR，日志操作员呼号）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="值班员" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding OPERATOR}" />
                                            </Border>

                                            <!--  DXCC代码（ADIF: MY_DXCC）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="DXCC代码" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="5"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_DXCC}" />
                                            </Border>

                                            <!--  CQ分区（ADIF: MY_CQ_ZONE）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="6"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="CQ分区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="7"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_CQ_ZONE}" />
                                            </Border>

                                            <!--  ITU分区（ADIF: MY_ITU_ZONE）  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="8"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="ITU分区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="9"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_ITU_ZONE}" />
                                            </Border>

                                            <!--  ══════════════ 第 2 行 ══════════════  -->

                                            <!--  网格（ADIF: MY_GRIDSQUARE）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="网格" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_GRIDSQUARE}" />
                                            </Border>

                                            <!--  国家/地区（ADIF: MY_COUNTRY）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="国家/地区" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_COUNTRY}" />
                                            </Border>

                                            <!--  经度（ADIF: MY_LON）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="4"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="经度" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="5"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_LON}" />
                                            </Border>

                                            <!--  纬度（ADIF: MY_LAT）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="6"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="纬度" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="7"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_LAT}" />
                                            </Border>

                                            <!--  邮政编码（ADIF: MY_POSTAL_CODE）  -->
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="8"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="邮政编码" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="9"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_POSTAL_CODE}" />
                                            </Border>

                                            <!--  ══════════════ 第 3 行：Excel 中为 A3:J3 整行合并的空行，作分组间距用，不放控件 ══════════════  -->

                                            <!--  ══════════════ 第 4 行 ══════════════  -->

                                            <!--  台站地址（ADIF: MY_STREET，本站街道地址；标签占 A:B，输入框占 C:E）  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="台站地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_STREET}" />
                                            </Border>

                                            <!--  通讯地址（项目自定义，ADIF 无对应本站字段；标签占 F:G，输入框占 H:J）  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="通讯地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_MailAddress}" />
                                            </Border>

                                            <!--  ══════════════ 第 5 行 ══════════════  -->

                                            <!--  QSL邮寄地址（项目自定义，ADIF 无对应本站字段）  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="QSL邮寄地址" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_QslAddress}" />
                                            </Border>

                                            <!--  电子邮箱（项目自定义；ADIF 的 EMAIL 指对方邮箱，不能复用）  -->
                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="电子邮箱" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="4"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_Email}" />
                                            </Border>

                                            <!--  ══════════════ 第 6 行 ══════════════  -->

                                            <!--  常用天线（ADIF: MY_ANTENNA）  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="常用天线" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_ANTENNA}" />
                                            </Border>

                                            <!--  常用设备（ADIF: MY_RIG）  -->
                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="5"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource InOptionCardPanelStyle}">
                                                <Label Style="{StaticResource InOptionLabelStyle}">
                                                    <TextBlock Text="常用设备" />
                                                </Label>
                                            </Border>

                                            <Border
                                                Grid.Row="5"
                                                Grid.Column="7"
                                                Grid.ColumnSpan="3"
                                                Padding="2,2,1,2"
                                                Style="{StaticResource InOptionInPutPanelStyle}">
                                                <TextBox Text="{Binding MY_RIG}" />
                                            </Border>



                                        </Grid>



                                    </Border>
                                </Grid>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1">
                            <!--  放弃界面上的修改，重新从数据库读取设置填入界面  -->
                            <Button
                                Command="{Binding CancelSettingsChangeCommand}"
                                Content="取消更改"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Border>
                        <Border Grid.Column="2">
                            <!--  重置界面为默认值（只改界面，需再点保存才写库）  -->
                            <Button
                                Command="{Binding ResetSettingsCommand}"
                                Content="恢复到默认设置"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Border>
                        <Border Grid.Column="3">
                            <!--  把界面上的设置写入数据库（首次插入，之后覆盖）  -->
                            <Button
                                Command="{Binding SaveSettingsCommand}"
                                Content="保存设置"
                                Style="{StaticResource InOptionButtonStyle}" />
                        </Border>
                    </Grid>
                </Border>

            </Grid>

        </TabItem>
    </TabControl>
</Window>
