<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">
    <!--
      ⚠ 必须【先】合并 BaseStyle：
        BasedOn 里的 StaticResource 是在【本字典被加载的那一刻】求值的，
        而那时 FormStyle 的其它兄弟册还没合并进来 —— 只有本字典自己
        MergedDictionaries 里的东西才在查找范围内。
        （Setter 里的 StaticResource 是延迟到样式被使用时才求值，所以不受此限）
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Style/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>






    <!--  ==================== 滚动条滑块（Thumb）共用样式 ====================  -->
    <!--  垂直/水平滚动条共用此滑块外观，改颜色只需改这里一处  -->
    <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="thumbBorder"
                        Background="{StaticResource ScrollBarThumbNormalBrush}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <!--  鼠标悬停：滑块变亮  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <!--  正在拖拽：滑块最亮  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbDragBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== 滚动条模板（供下面的具名样式与隐式样式共用） ====================  -->
    <!--
      把模板从 Style 里提取出来单独定义，是为了让下面的【隐式样式】也能引用它们，
      避免同一份模板内容在文件里抄两遍。

      ⚠ 必须定义在引用它们的 Style 之前 ——
        XAML 的 StaticResource 不支持前向引用（详见记忆第 2 册问答 #41）。
    -->

    <!--  垂直滚动条模板  -->
    <ControlTemplate x:Key="DarkVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid>
            <!--  轨道底色  -->
            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

            <!--
                ★ 关键属性：IsDirectionReversed="True" ★
                作用：让滑块的移动方向与内容滚动方向一致
                （内容在顶部 → 滑块在顶部；向下滚动 → 滑块向下）
                注意：垂直滚动条【必须】加这个属性，否则方向会整个反过来
                （表现为：内容在顶部时滑块却停在底部）
                水平滚动条则不需要此属性（见下方横向模板）
            -->
            <Track
                x:Name="PART_Track"
                IsDirectionReversed="True"
                Orientation="Vertical">
                <Track.Thumb>
                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!--  水平滚动条模板  -->
    <ControlTemplate x:Key="DarkHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid>
            <!--  轨道底色  -->
            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

            <!--
                水平方向使用 Track 的默认方向即可（无需 IsDirectionReversed）
                因为从左到右滚动时，滑块本来就应该从左往右移动
            -->
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.Thumb>
                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!--  ==================== 【垂直滚动条】样式 ====================  -->
    <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【滚动条宽度】就在这里改！单位=像素，建议范围 6~12：
                6  = 纤细（当前值）
                8  = 常规
                10 = 更容易用鼠标点中
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Width" Value="6" />
            <!--
                ★ 必须保留这一行，否则上面的 Width 改小于 16.8 不会生效！★
                原因：WPF 主题样式（ThemeStyle）给 ScrollBar 设了
                MinWidth = SystemParameters.VerticalScrollBarWidth = 16.8
                而显式 Style 与主题样式是两个独立来源——本样式没设置 MinWidth 时，
                主题样式的 16.8 依然生效，实际宽度会被撑到 max(Width, 16.8)。
                显式写成 0 才能让 Width 真正说了算。
            -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <!--  模板统一放在上面的 DarkVerticalScrollBarTemplate 里，这里只负责引用  -->
            <Setter Property="Template" Value="{StaticResource DarkVerticalScrollBarTemplate}" />
        </Style.Setters>
    </Style>

    <!--  ==================== 【水平滚动条】样式 ====================  -->
    <!--  用途：横向滚动时使用（配合下方的 DarkBothScrollViewerStyle 或单独给 ScrollBar 使用）  -->
    <Style x:Key="DarkHorizontalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【横向滚动条高度】就在这里改！单位=像素，建议与垂直滚动条宽度保持一致：
                当前值 8（与垂直滚动条宽度一致）
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Height" Value="8" />
            <!--  ★ 同垂直滚动条：必须覆盖主题样式强加的 MinHeight（同样约 16.8），否则高度改不小 ★  -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <!--  模板统一放在上面的 DarkHorizontalScrollBarTemplate 里，这里只负责引用  -->
            <Setter Property="Template" Value="{StaticResource DarkHorizontalScrollBarTemplate}" />
        </Style.Setters>
    </Style>

    <!--  ==================== 【隐式滚动条样式】====================  -->
    <!--
      ⚠ 为什么需要它：
        ScrollViewer 内部的滚动条，可以在 ScrollViewer 的模板里用上面那两个
        【具名样式】明确指定（见下方 DarkOnlyVerticalScrollViewerStyle）。

        但 DataGrid、ListBox、TreeView 这类控件的滚动条，藏在它们【自带的模板内部】，
        从外面根本够不着 —— 它们只会走"隐式样式"这条路：
        本样式只写 TargetType、不带 x:Key，于是界面里只要出现 ScrollBar，
        就会自动套上它。

      效果：DataGrid 的滚动条从此与页面上的 ScrollViewer 完全一致。

      影响范围：全局。项目里所有 ScrollBar 都会变成这个外观
                （本来也是想统一；若将来某个控件确实需要例外，
                 在那个控件上单独设 Style 即可覆盖）。

      ⚠ 垂直与水平方向共用这一个样式，靠 Trigger 按 Orientation 切换模板与尺寸 ——
        因为 WPF 不允许在 Style 里把另一个 Style 赋给 Setter
        （Setter 的值只能是具体值或模板，不能是另一个 Style）。
    -->
    <Style TargetType="ScrollBar">
        <!--
          两个方向都要把主题样式强加的 16.8 最小值覆盖成 0，
          否则 Width / Height 改小于 16.8 时不会生效
          （原因见上面垂直滚动条样式里的详细说明）。
        -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
        <!--  默认按垂直方向处理  -->
        <Setter Property="Width" Value="6" />
        <Setter Property="Template" Value="{StaticResource DarkVerticalScrollBarTemplate}" />

        <Style.Triggers>
            <!--  方向为水平时，换成横向的尺寸与模板  -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template" Value="{StaticResource DarkHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ==================== ScrollViewer 模板：仅垂直滚动条 ====================  -->
    <!--  用途：右侧日志列表等只需上下滚动的区域（当前 MainLogWindow 使用此样式）  -->
    <Style x:Key="DarkOnlyVerticalScrollViewerStyle" TargetType="ScrollViewer">
        <!--  水平滚动条彻底禁用（内容超宽时也不会出现横向滚动条）  -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  主体内容区域（承载要滚动的内容）  -->
                        <ScrollContentPresenter
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条  -->
                        <!--
                            说明：Visibility 必须绑定 ComputedVerticalScrollBarVisibility
                            （实际计算后的可见性），不能绑定 VerticalScrollBarVisibility
                            （那是设置值，类型为 ScrollBarVisibility 枚举，与 Visibility 不匹配，
                            会导致 VerticalScrollBarVisibility="Auto" 时无法正确显示）
                        -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== ScrollViewer 模板：横竖双向滚动条 ====================  -->
    <!--
        用途：需要横向滚动的区域（如宽表格、长文本不换行的列表）改用此样式即可。

        【横向滚动条开关】在使用处用属性控制，无需改本样式：
            默认（不写）= Auto   → 内容超出宽度时自动出现横向滚动条
            想关闭       = 在 ScrollViewer 上写 HorizontalScrollBarVisibility="Disabled"
            想常显示     = 写 HorizontalScrollBarVisibility="Visible"

        使用示例：
            <ScrollViewer Style="{StaticResource DarkBothScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Auto">
                ...内容...
            </ScrollViewer>
    -->
    <Style x:Key="DarkBothScrollViewerStyle" TargetType="ScrollViewer">
        <!--  两个方向都用 Auto：内容超出才出现对应滚动条，不超出则干净无痕  -->
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  主体内容区域  -->
                        <ScrollContentPresenter
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条（靠右）  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  水平滚动条（靠下）  -->
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Orientation="Horizontal"
                            Style="{StaticResource DarkHorizontalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  右下角补角：横竖滚动条同时出现时填充角落的空白  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource ScrollBarTrackBrush}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
