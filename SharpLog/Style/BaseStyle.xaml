<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">




    <!--  ========== Style样式定义 全部带TargetType ==========  -->

    <!--  1. Window 主窗体基础样式  -->
    <Style x:Key="LogMainWindowStyle" TargetType="Window">
        <!--  窗体背景色  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <!--  窗体内默认文字颜色  -->
        <Setter Property="Foreground" Value="{StaticResource LogMainFormFontColor}" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）结构性分区Border  -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）内层需要使用的Border  -->
    <Style x:Key="InCardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InPanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2.5" />
        <Setter Property="Margin" Value="2" />

    </Style>

    <!--  3. Label 主标题样式  -->
    <Style x:Key="LabelMainTitleStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  4. Label 正文普通文字  -->
    <Style x:Key="LabelTextStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  5. Label 次要备注文字  -->
    <Style x:Key="LabelSecondaryNoteStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryNoteColor}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  6. TextBox 暗色输入框（支持焦点切换边框颜色）  -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FocusTextBoxTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  7. 主功能按钮（支持悬浮、点击、禁用三种状态）  -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonNormalTextColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  鼠标悬浮  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下点击  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonClickBackColor}" />
            </Trigger>
            <!--  控件禁用状态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <!--  7.1 次要功能按钮（幽灵按钮：透明底 + 细边框，用于取消 / 重置 / 浏览等非主操作）  -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <!--  透明背景 + 细边框，与主按钮的实心蓝形成「主次」对比  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="2.8"/>
        <!--  以下三项（内边距 / 字号 / 圆角）与主按钮完全一致，
              保证两种按钮并排摆放时高度与圆角统一，不会一高一矮  -->
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  鼠标悬浮：只填充一层很淡的背景，边框保持不变  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下：背景再亮一档，形成按压反馈  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonClickBackColor}" />
            </Trigger>
            <!--  禁用：文字与边框同时变暗，视觉上退到最弱  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--  ================================================================
          右键菜单（日志查看表格的行操作菜单）
          WPF 原生的 ContextMenu / MenuItem 是浅色皮肤，与暗色主题冲突，
          这里一并重写。配色沿用面板与次要按钮的色键。
          ================================================================  -->

    <!--  菜单容器  -->
    <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <!--  IsItemsHost 告诉 WPF：菜单项放在这里  -->
                        <StackPanel
                            Margin="{TemplateBinding Padding}"
                            IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  菜单项  -->
    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="ItemBorder"
                        Background="Transparent"
                        CornerRadius="3">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
