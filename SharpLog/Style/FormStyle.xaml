<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">



    <!--  ========== Style样式定义 全部带TargetType ==========  -->

    <!--  1. Window 主窗体基础样式  -->
    <Style x:Key="LogMainWindowStyle" TargetType="Window">
        <!--  窗体背景色  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <!--  窗体内默认文字颜色  -->
        <Setter Property="Foreground" Value="{StaticResource LogMainFormFontColor}" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）结构性分区Border  -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）内层需要使用的Border  -->
    <Style x:Key="InCardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InPanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2.5" />
        <Setter Property="Margin" Value="2" />

    </Style>

    <!--  3. Label 主标题样式  -->
    <Style x:Key="LabelMainTitleStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  4. Label 正文普通文字  -->
    <Style x:Key="LabelTextStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  5. Label 次要备注文字  -->
    <Style x:Key="LabelSecondaryNoteStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryNoteColor}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  6. TextBox 暗色输入框（支持焦点切换边框颜色）  -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FocusTextBoxTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  7. 主功能按钮（支持悬浮、点击、禁用三种状态）  -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonNormalTextColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  鼠标悬浮  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下点击  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonClickBackColor}" />
            </Trigger>
            <!--  控件禁用状态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <!--  8. DataGrid 暗色日志表格（对应原DataGridView）  -->
    <Style x:Key="LogDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#FF30333A" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  取消默认选中浅色背景干扰  -->
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <!--  DataGrid 表头样式  -->
    <Style x:Key="LogDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DgvHeaderBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvHeaderTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  DataGrid 数据行样式  -->
    <Style x:Key="LogDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Style.Triggers>
            <!--  行选中样式  -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DgvRowSelectedBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource DgvRowSelectedTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  DataGrid单元格样式  -->
    <Style x:Key="LogDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!--  TabControl 整体容器样式  -->
    <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  标签头部对齐靠左  -->
        <Setter Property="TabStripPlacement" Value="Top" />
    </Style>

    <!--  TabControl 整体容器样式-用于页面内的切换页面的使用  -->
    <Style x:Key="InDarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="2" />
        <!--  标签头部对齐靠左  -->
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  标签头部  -->
                        <TabPanel
                            x:Name="HeaderPanel"
                            Grid.Row="0"
                            Margin="0,0,0,0"
                            Background="{TemplateBinding Background}"
                            IsItemsHost="True" />
                        <!--  标签内容区域  -->
                        <Border
                            x:Name="ContentPanel"
                            Grid.Row="1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,6,6">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  TabItem 标签头部样式（核心，包含选中/悬浮触发器）  -->
    <!--  TabItem 标签头部样式（修复选中出现白色背景问题）  -->
    <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="14" />
        <!--<Setter Property="MinWidth" Value=""/>-->
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,2,0,0" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0" />

                        <!--  顶部高亮蓝条，选中才显示  -->
                        <Border
                            x:Name="ActiveLine"
                            Height="3"
                            Margin="8,2,8,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem 标签头部样式（核心，包含选中/悬浮触发器）  -->
    <!--  TabItem 标签头部样式（修复选中出现白色背景问题）  -->
    <!--  页面内部用来切换页面的标签头部样式  -->
    <Style x:Key="InDarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="14,2,14,0" />
        <Setter Property="FontSize" Value="12" />
        <!--<Setter Property="MinWidth" Value=""/>-->
        <Setter Property="Height" Value="28" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0" />

                        <!--  顶部高亮蓝条，选中才显示  -->
                        <Border
                            x:Name="ActiveLine"
                            Height="1.5"
                            Margin="8,2,8,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem内部内容容器样式（标签页面板）  -->
    <Style x:Key="DarkTabContentStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>


    <!--  ========== 带右下角单位后缀的 TextBox 样式（暗色主题适配） ==========  -->
    <!--  使用方式：Style="{StaticResource UnitTextBoxStyle}"  Tag="填写单位，如 kHz / MHz / W"  -->
    <Style x:Key="UnitTextBoxStyle" TargetType="TextBox">
        <!--  基础默认值，和你现有普通输入框保持一致  -->
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextAlignment" Value="Center" />

        <!--  核心：重写控件外观模板  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--  最外层边框：负责背景、边框、圆角  -->
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                        <!--  内部网格：层叠放置输入内容 + 单位文字  -->
                        <Grid>
                            <!--  【必须保留】输入内容宿主，PART_ContentHost 是WPF固定命名，不能改名  -->
                            <!--  右侧Padding预留40px空间，防止输入文字和单位重叠  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="8,4,42,4"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <!--  右下角单位提示文字  -->
                            <TextBlock
                                Margin="0,0,3,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="8"
                                Foreground="{StaticResource PlaceholderTextColor}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Tag}" />
                        </Grid>
                    </Border>

                    <!--  触发器：输入框获得焦点时，边框变成主题蓝色  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  时间标题文字基础样式  -->
    <Style x:Key="TimeStyle_" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />

    </Style>

    <!--  时间标题文字样式  -->
    <Style
        x:Key="TimeLabelStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="12" />

    </Style>

    <!--  时间显示文字样式  -->
    <Style
        x:Key="TimeStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="Padding" Value="0,0,0,0" />
    </Style>

    <!--  日期显示文字样式  -->
    <Style
        x:Key="TimeDataStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />
    </Style>

    <!--  时间内容框格式  -->
    <Style
        x:Key="TimeBorder"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">

        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />

    </Style>

    <!--  UTC时区加减文本  -->
    <Style x:Key="UTCZoneStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />

    </Style>



    <!--  ==================== 滚动条滑块（Thumb）共用样式 ====================  -->
    <!--  垂直/水平滚动条共用此滑块外观，改颜色只需改这里一处  -->
    <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="thumbBorder"
                        Background="{StaticResource ScrollBarThumbNormalBrush}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <!--  鼠标悬停：滑块变亮  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <!--  正在拖拽：滑块最亮  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbDragBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== 【垂直滚动条】样式 ====================  -->
    <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【滚动条宽度】就在这里改！单位=像素，建议范围 6~12：
                    6  = 纤细（当前值）
                    8  = 常规
                    10 = 更容易用鼠标点中
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Width" Value="6" />
            <!--
                ★ 必须保留这一行，否则上面的 Width 改小于 16.8 不会生效！★
                原因：WPF 主题样式（ThemeStyle）给 ScrollBar 设了
                      MinWidth = SystemParameters.VerticalScrollBarWidth = 16.8
                      而显式 Style 与主题样式是两个独立来源——本样式没设置 MinWidth 时，
                      主题样式的 16.8 依然生效，实际宽度会被撑到 max(Width, 16.8)。
                      显式写成 0 才能让 Width 真正说了算。
            -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!--  轨道底色  -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

                            <!--
                                ★ 关键属性：IsDirectionReversed="True" ★
                                作用：让滑块的移动方向与内容滚动方向一致
                                      （内容在顶部 → 滑块在顶部；向下滚动 → 滑块向下）
                                注意：垂直滚动条【必须】加这个属性，否则方向会整个反过来
                                      （表现为：内容在顶部时滑块却停在底部）
                                水平滚动条则不需要此属性（见下方横向样式）
                            -->
                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Orientation="Vertical">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <!--  ==================== 【水平滚动条】样式 ====================  -->
    <!--  用途：横向滚动时使用（配合下方的 DarkBothScrollViewerStyle 或单独给 ScrollBar 使用）  -->
    <Style x:Key="DarkHorizontalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【横向滚动条高度】就在这里改！单位=像素，建议与垂直滚动条宽度保持一致：
                    当前值 8（与垂直滚动条宽度一致）
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Height" Value="8" />
            <!--  ★ 同垂直滚动条：必须覆盖主题样式强加的 MinHeight（同样约 16.8），否则高度改不小 ★  -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!--  轨道底色  -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

                            <!--
                                水平方向使用 Track 的默认方向即可（无需 IsDirectionReversed）
                                因为从左到右滚动时，滑块本来就应该从左往右移动
                            -->
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <!--  ==================== ScrollViewer 模板：仅垂直滚动条 ====================  -->
    <!--  用途：右侧日志列表等只需上下滚动的区域（当前 MainLogWindow 使用此样式）  -->
    <Style x:Key="DarkOnlyVerticalScrollViewerStyle" TargetType="ScrollViewer">
        <!--  水平滚动条彻底禁用（内容超宽时也不会出现横向滚动条）  -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  主体内容区域（承载要滚动的内容）  -->
                        <ScrollContentPresenter
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条  -->
                        <!--  说明：Visibility 必须绑定 ComputedVerticalScrollBarVisibility
                                  （实际计算后的可见性），不能绑定 VerticalScrollBarVisibility
                                  （那是设置值，类型为 ScrollBarVisibility 枚举，与 Visibility 不匹配，
                                    会导致 VerticalScrollBarVisibility="Auto" 时无法正确显示）  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== ScrollViewer 模板：横竖双向滚动条 ====================  -->
    <!--
        用途：需要横向滚动的区域（如宽表格、长文本不换行的列表）改用此样式即可。

        【横向滚动条开关】在使用处用属性控制，无需改本样式：
            默认（不写）= Auto   → 内容超出宽度时自动出现横向滚动条
            想关闭       = 在 ScrollViewer 上写 HorizontalScrollBarVisibility="Disabled"
            想常显示     = 写 HorizontalScrollBarVisibility="Visible"

        使用示例：
            <ScrollViewer Style="{StaticResource DarkBothScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Auto">
                ...内容...
            </ScrollViewer>
    -->
    <Style x:Key="DarkBothScrollViewerStyle" TargetType="ScrollViewer">
        <!--  两个方向都用 Auto：内容超出才出现对应滚动条，不超出则干净无痕  -->
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  主体内容区域  -->
                        <ScrollContentPresenter
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条（靠右）  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  水平滚动条（靠下）  -->
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Orientation="Horizontal"
                            Style="{StaticResource DarkHorizontalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  右下角补角：横竖滚动条同时出现时填充角落的空白  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource ScrollBarTrackBrush}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TimeInPut_HC"
        BasedOn="{StaticResource {x:Type hc:DateTimePicker}}"
        TargetType="hc:DateTimePicker">
        <Setter Property="DateTimeFormat" Value="yyyy/MM/dd-HH:mm:ss" />
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="FontSize" Value="13" />

    </Style>

    <!--小表格里面的标签样式-->
    <Style
        x:Key="LittleLabelStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12 " />
    </Style>

    <!--小表格里面的卡片面板-->
    <Style
        x:Key="LittleCardPanelStyle"
        BasedOn="{StaticResource CardPanelStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="5,0,5,0" />
        <Setter Property="Margin" Value="2,1,2,1" />

    </Style>

    <!--状态栏里面的文字标签样式-->
    <Style
        x:Key="EffectLabelStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14 " />
        <Setter Property="Margin" Value="3,8,0,8" />
        
        
    </Style>






</ResourceDictionary>