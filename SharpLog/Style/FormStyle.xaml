<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <!--  ========== Style样式定义 全部带TargetType ==========  -->

    <!--  1. Window 主窗体基础样式  -->
    <Style x:Key="LogMainWindowStyle" TargetType="Window">
        <!--  窗体背景色  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <!--  窗体内默认文字颜色  -->
        <Setter Property="Foreground" Value="{StaticResource LogMainFormFontColor}" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）结构性分区Border  -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）内层需要使用的Border  -->
    <Style x:Key="InCardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InPanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="2" />

    </Style>

    <!--  3. Label 主标题样式  -->
    <Style x:Key="LabelMainTitleStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  4. Label 正文普通文字  -->
    <Style x:Key="LabelTextStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  5. Label 次要备注文字  -->
    <Style x:Key="LabelSecondaryNoteStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryNoteColor}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  6. TextBox 暗色输入框（支持焦点切换边框颜色）  -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FocusTextBoxTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                <Setter Property="BorderThickness" Value="3" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  7. 主功能按钮（支持悬浮、点击、禁用三种状态）  -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonNormalTextColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Style.Triggers>
            <!--  鼠标悬浮  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下点击  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonClickBackColor}" />
            </Trigger>
            <!--  控件禁用状态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  8. DataGrid 暗色日志表格（对应原DataGridView）  -->
    <Style x:Key="LogDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#FF30333A" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  取消默认选中浅色背景干扰  -->
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <!--  DataGrid 表头样式  -->
    <Style x:Key="LogDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DgvHeaderBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvHeaderTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  DataGrid 数据行样式  -->
    <Style x:Key="LogDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Style.Triggers>
            <!--  行选中样式  -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DgvRowSelectedBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource DgvRowSelectedTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  DataGrid单元格样式  -->
    <Style x:Key="LogDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!--  TabControl 整体容器样式  -->
    <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  标签头部对齐靠左  -->
        <Setter Property="TabStripPlacement" Value="Top" />
    </Style>

    <!--  TabItem 标签头部样式（核心，包含选中/悬浮触发器）  -->
    <!--  TabItem 标签头部样式（修复选中出现白色背景问题）  -->
    <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="14" />
        <!--<Setter Property="MinWidth" Value=""/>-->
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,2,0,0" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0" />

                        <!--  顶部高亮蓝条，选中才显示  -->
                        <Border
                            x:Name="ActiveLine"
                            Height="3"
                            Margin="8,2,8,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem内部内容容器样式（标签页面板）  -->
    <Style x:Key="DarkTabContentStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>


    <!--  ========== 带右下角单位后缀的 TextBox 样式（暗色主题适配） ==========  -->
    <!--  使用方式：Style="{StaticResource UnitTextBoxStyle}"  Tag="填写单位，如 kHz / MHz / W"  -->
    <Style x:Key="UnitTextBoxStyle" TargetType="TextBox">
        <!--  基础默认值，和你现有普通输入框保持一致  -->
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextAlignment" Value="Center" />

        <!--  核心：重写控件外观模板  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--  最外层边框：负责背景、边框、圆角  -->
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                        <!--  内部网格：层叠放置输入内容 + 单位文字  -->
                        <Grid>
                            <!--  【必须保留】输入内容宿主，PART_ContentHost 是WPF固定命名，不能改名  -->
                            <!--  右侧Padding预留40px空间，防止输入文字和单位重叠  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="8,4,42,4"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <!--  右下角单位提示文字  -->
                            <TextBlock
                                Margin="0,0,3,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="8"
                                Foreground="{StaticResource PlaceholderTextColor}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Tag}" />
                        </Grid>
                    </Border>

                    <!--  触发器：输入框获得焦点时，边框变成主题蓝色  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  时间标题文字基础样式  -->
    <Style x:Key="TimeStyle_" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />

    </Style>

    <!--  时间标题文字样式  -->
    <Style
        x:Key="TimeLabelStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="10" />

    </Style>

    <!--  时间显示文字样式  -->
    <Style
        x:Key="TimeStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="Padding" Value="0,0,0,0" />
    </Style>

    <!--  日期显示文字样式  -->
    <Style
        x:Key="TimeDataStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />
    </Style>

    <!--  时间内容框格式  -->
    <Style
        x:Key="TimeBorder"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">

        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />

    </Style>

    <!--UTC时区加减文本-->
    <Style x:Key="UTCZoneStyle" TargetType="Label" >
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Padding"  Value="0"/>
        <Setter Property="FontSize" Value="7.5"/>
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}"/>

    </Style>


</ResourceDictionary>