<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">

    <!--
      ══════════════════════════════════════════════════════════════════════
      样式聚合入口
      ──────────────────────────────────────────────────────────────────────
      本文件【不再直接定义样式】，只负责把各分册合并起来。
      外部（App.xaml 与各 View）的引用路径不变，仍然引这个 FormStyle.xaml。

      ⚠⚠ 合并顺序 = 依赖顺序，不能随意调换：
         StaticResource 是【加载时解析】的，若某样式 BasedOn 了尚未合并进来的
         样式，运行时直接抛 XamlParseException（编译期查不出）。
         当前所有跨册依赖都指向 BaseStyle，所以它必须排第一。

         BaseStyle        基础：窗口 / 面板 / 三种 Label / DarkTextBox /
                          两种按钮 / 右键菜单        ← 被后面各册依赖
         TabControlStyle  顶部 / 页内 / 左侧竖排 三套 TabControl + TabItem
         DataGridStyle    DarkDataGrid* 系列
         LogEditStyle     日志编辑页：时间输入、单位、加载更多、UTC 时区
         ScrollBarStyle   滚动条与 ScrollViewer（含隐式 ScrollBar 样式）
         SettingStyle     设置页：Little* / Option* / InOption* / TimeInPut_HC
         EditQsoStyle     EditQso 编辑窗口：Edit* 系列 + 3 个 hc 控件样式
      ══════════════════════════════════════════════════════════════════════
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Style/BaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/TabControlStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/DataGridStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/LogEditStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/ScrollBarStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/SettingStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Style/EditQsoStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>