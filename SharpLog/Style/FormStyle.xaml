<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">



    <!--  ========== Style样式定义 全部带TargetType ==========  -->

    <!--  1. Window 主窗体基础样式  -->
    <Style x:Key="LogMainWindowStyle" TargetType="Window">
        <!--  窗体背景色  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <!--  窗体内默认文字颜色  -->
        <Setter Property="Foreground" Value="{StaticResource LogMainFormFontColor}" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）结构性分区Border  -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  2. 卡片容器Border（替代WinForm Panel）内层需要使用的Border  -->
    <Style x:Key="InCardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InPanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2.5" />
        <Setter Property="Margin" Value="2" />

    </Style>

    <!--  3. Label 主标题样式  -->
    <Style x:Key="LabelMainTitleStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  4. Label 正文普通文字  -->
    <Style x:Key="LabelTextStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  5. Label 次要备注文字  -->
    <Style x:Key="LabelSecondaryNoteStyle" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryNoteColor}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  6. TextBox 暗色输入框（支持焦点切换边框颜色）  -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FocusTextBoxTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  7. 主功能按钮（支持悬浮、点击、禁用三种状态）  -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource ButtonNormalTextColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  鼠标悬浮  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下点击  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonClickBackColor}" />
            </Trigger>
            <!--  控件禁用状态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <!--  7.1 次要功能按钮（幽灵按钮：透明底 + 细边框，用于取消 / 重置 / 浏览等非主操作）  -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <!--  透明背景 + 细边框，与主按钮的实心蓝形成「主次」对比  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LabelTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="2.8"/>
        <!--  以下三项（内边距 / 字号 / 圆角）与主按钮完全一致，
              保证两种按钮并排摆放时高度与圆角统一，不会一高一矮  -->
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  鼠标悬浮：只填充一层很淡的背景，边框保持不变  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBackColor}" />
            </Trigger>
            <!--  鼠标按下：背景再亮一档，形成按压反馈  -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonClickBackColor}" />
            </Trigger>
            <!--  禁用：文字与边框同时变暗，视觉上退到最弱  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  8. DataGrid 暗色日志表格（对应原DataGridView）  -->
    <Style x:Key="LogDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#FF30333A" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  取消默认选中浅色背景干扰  -->
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <!--  DataGrid 表头样式  -->
    <Style x:Key="LogDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DgvHeaderBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvHeaderTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  DataGrid 数据行样式  -->
    <Style x:Key="LogDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Style.Triggers>
            <!--  行选中样式  -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DgvRowSelectedBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource DgvRowSelectedTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  DataGrid单元格样式  -->
    <Style x:Key="LogDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!--  TabControl 整体容器样式  -->
    <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  标签头部对齐靠左  -->
        <Setter Property="TabStripPlacement" Value="Top" />
    </Style>

    <!--  TabControl 整体容器样式-用于页面内的切换页面的使用  -->
    <Style x:Key="InDarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="2" />
        <!--  标签头部对齐靠左  -->
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  标签头部  -->
                        <TabPanel
                            x:Name="HeaderPanel"
                            Grid.Row="0"
                            Margin="0,0,0,0"
                            Background="{TemplateBinding Background}"
                            IsItemsHost="True" />
                        <!--  标签内容区域  -->
                        <Border
                            x:Name="ContentPanel"
                            Grid.Row="1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,6,6">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  TabItem 标签头部样式（核心，包含选中/悬浮触发器）  -->
    <!--  TabItem 标签头部样式（修复选中出现白色背景问题）  -->
    <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="14" />
        <!--<Setter Property="MinWidth" Value=""/>-->
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,2,0,0" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0" />

                        <!--  顶部高亮蓝条，选中才显示  -->
                        <Border
                            x:Name="ActiveLine"
                            Height="3"
                            Margin="8,2,8,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem 标签头部样式（核心，包含选中/悬浮触发器）  -->
    <!--  TabItem 标签头部样式（修复选中出现白色背景问题）  -->
    <!--  页面内部用来切换页面的标签头部样式  -->
    <Style x:Key="InDarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="14,2,14,0" />
        <Setter Property="FontSize" Value="12" />
        <!--<Setter Property="MinWidth" Value=""/>-->
        <Setter Property="Height" Value="28" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0" />

                        <!--  顶部高亮蓝条，选中才显示  -->
                        <Border
                            x:Name="ActiveLine"
                            Height="1.5"
                            Margin="8,2,8,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          TabControl 样式：标签栏在【左侧】+ 文字竖排
          ────────────────────────────────────────────────────────────────
          用法：
            <TabControl Style="{StaticResource LeftDarkTabControlStyle}">
                <TabItem Header="日志编辑" Style="{StaticResource LeftDarkTabItemStyle}">
                    ...页面内容...
                </TabItem>
                <TabItem Header="日志查看" Style="{StaticResource LeftDarkTabItemStyle}">
                    ...页面内容...
                </TabItem>
            </TabControl>

          配色完全沿用上面 DarkTabControlStyle 的那套色键，未新增任何颜色，
          与界面上已有的顶部标签栏在观感上保持一致：
            常态 #202328 / 悬浮 #2C3038 / 选中 #121418 / 选中指示条 蓝色
          ================================================================  -->

    <!--  TabControl 整体容器样式-标签栏在左侧  -->
    <Style x:Key="LeftDarkTabControlStyle" TargetType="TabControl">
        <!--  内容区域背景，和主窗体背景统一  -->
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  核心：标签栏放到左侧  -->
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <!--
                          与顶部版镜像：Top 版把空间分成「上下两行」，
                          这里改成「左右两列」。
                        -->
                        <Grid.ColumnDefinitions>
                            <!--  标签栏：宽度由最宽的那个标签决定  -->
                            <ColumnDefinition Width="Auto" />
                            <!--  内容区：占满剩余空间  -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                          标签头部。
                          TabPanel 会自己识别 TabStripPlacement=Left 并改为【竖向排列】，
                          不需要在这里手动指定 Orientation，这是 WPF 的内置行为。
                        -->
                        <TabPanel
                            x:Name="HeaderPanel"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            IsItemsHost="True" />

                        <!--  标签内容区域  -->
                        <Border
                            x:Name="ContentPanel"
                            Grid.Column="1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,6,6">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem 标签头部样式-标签栏在左侧 + 文字竖排  -->
    <Style x:Key="LeftDarkTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabItemNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource TabItemNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <!--
          边框：顶部版是 1,1,1,0（不画下边，因为下方接内容区），
          这里镜像成 1,1,0,1（不画右边，因为右侧接内容区）。
          顺序为 左,上,右,下。
        -->
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <!--  竖排后横向留白要小、纵向留白要大  -->
        <Setter Property="Padding" Value="6,10" />
        <Setter Property="FontSize" Value="13" />
        <!--
          竖排时标签是「窄而高」的形状：
          宽度固定（所有标签对齐），高度由文字长度自然决定，不设 Height。
        -->
        <Setter Property="Width" Value="34" />
        <!--  保证只有两个字时也有足够的点击区域  -->
        <Setter Property="MinHeight" Value="54" />
        <!--  与顶部版镜像：顶部版标签之间留纵向间隔，这里改成横向间隔  -->
        <Setter Property="Margin" Value="0,0,2,0" />

        <!--  核心：重写控件模板，消除原生选中白色背景  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,0,0,6" />

                        <!--
                          选中高亮条。
                          顶部版它在「上边」，本版镜像到「右边」。
                          规律是：永远贴在【标签与内容区相接】的那条边上。
                        -->
                        <Border
                            x:Name="ActiveLine"
                            Width="3"
                            Margin="0,8,2,8"
                            HorizontalAlignment="Right"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            CornerRadius="3,3,3,3"
                            Visibility="Collapsed" />

                        <!--
                          ★ 竖排文字的实现要点 ★
                          Header 传入字符串时，ContentPresenter 会自动生成一个 TextBlock 来显示它。
                          这里通过 Resources 里的隐式样式给那个 TextBlock 设一个
                          「只放得下一个汉字」的宽度并允许折行，
                          中文字符就会逐字换行，形成竖排。

                          ⚠ 注意这是【每个字正立、自上而下】的真竖排，
                            不是把文字整体旋转 90 度（那样字是躺着的）。
                          ⚠ Width=16 是按 FontSize=13 的汉字宽度定的（约 13px）。
                            将来若调大字号，这个值要同步调大，否则会两个字挤在一行。
                          ⚠ 纯英文标签不会逐字断行（Wrap 只在单词边界折行），
                            本项目标签均为中文，不受影响。
                        -->
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <!--  行距略大于字号，竖排才不显得挤  -->
                                    <Setter Property="LineHeight" Value="17" />
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>


                    <!--  状态触发器：悬浮 / 选中（与顶部版完全一致）  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource TabItemSelectedBackColor}" />
                            <Setter Property="Foreground" Value="{StaticResource TabItemSelectedTextColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem内部内容容器样式（标签页面板）  -->
    <Style x:Key="DarkTabContentStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LogMainFormBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>


    <!--  ================================================================
          DataGrid 暗色样式（日志查看页的表格）
          ────────────────────────────────────────────────────────────────
          配色全部取自 ColorDic.xaml 里已有的 Dgv* 色键，未新增颜色：
            表头      DgvHeaderBackColor / DgvHeaderTextColor / DgvHeaderBorderColor
            数据行    DgvRowNormalBackColor / DgvRowNormalTextColor
            选中行    DgvRowSelectedBackColor / DgvRowSelectedTextColor
          ================================================================  -->

    <!--  表格整体  -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <!--  ──── 配色 ────  -->
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <!--
          网格线只画横线。列有三十多个，竖线会密得像栅栏，反而看不清内容；
          横向的格线足够帮眼睛在一行里对齐。
        -->
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <!--  行表头没什么用，关掉可以省下一列宽度  -->
        <Setter Property="HeadersVisibility" Value="Column" />

        <!--  ──── 行为 ────  -->
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <!--  只读：编辑走悬浮窗口，不放任在表格里直接改  -->
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <!--
          ★ 允许拖拽表头调整列顺序 ★
          本项默认为 True，这里显式写出来是为了让人一眼看到它是有意开启的。
          用法：按住某一列的表头往左右拖，松手即换位。
          ⚠ 前提是列由 XAML 手工定义（AutoGenerateColumns=False）。
            若让 DataGrid 自动生成列，重新绑定数据时列会被重建，顺序就丢了。
        -->
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="RowHeight" Value="26" />

        <!--
          ──── 虚拟化（数据量大时的命脉）────
          这三项配合起来，DataGrid 才只生成"看得见的那二十来行"的行容器，
          显示 2000 条和显示 20 条的渲染开销几乎一样。
        -->
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!--
          ⚠ CanContentScroll 必须保持 True。
            设成 False 会退化成"按像素滚动"，DataGrid 就得把每一行都量一遍才能
            算出总高度，虚拟化直接失效 —— 这是最常见的性能翻车点。
        -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        <!--  ──── 子元素样式 ────  -->
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DarkDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DarkDataGridCellStyle}" />
    </Style>

    <!--  表头单元格  -->
    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DgvHeaderBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvHeaderTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!--  表头重写模板：原生模板的背景是浅色硬编码的，只改 Setter 不管用  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border
                            x:Name="BackgroundBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />

                                <!--  排序方向箭头，仅在该列参与排序时出现  -->
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!--
                          ⚠ 这两个 Thumb 是【列宽拖拽手柄】，必须保留。
                            漏掉它们的话模板照样能显示，但用户会发现列宽拖不动了。
                            这里设成完全透明：手柄只负责响应鼠标，不参与外观。
                        -->
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Left"
                            Cursor="SizeWE"
                            Opacity="0" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Right"
                            Cursor="SizeWE"
                            Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <!--  向上的三角  -->
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 7,4 L 3.5,0 Z" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <!--  向下的三角  -->
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 7,0 L 3.5,4 Z" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  数据行  -->
    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="MinHeight" Value="26" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DgvRowSelectedBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource DgvRowSelectedTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  单元格  -->
    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
        <!--
          单元格背景设为透明，让【行的背景】透上来。
          否则选中时单元格会自己涂一层，与行的选中色打架，
          出现"整行蓝底、格子却是别的颜色"的花斑。
        -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <!--  原生模板里带一圈选中虚线框，一并去掉  -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  ================================================================
          右键菜单（日志查看表格的行操作菜单）
          WPF 原生的 ContextMenu / MenuItem 是浅色皮肤，与暗色主题冲突，
          这里一并重写。配色沿用面板与次要按钮的色键。
          ================================================================  -->

    <!--  菜单容器  -->
    <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <!--  IsItemsHost 告诉 WPF：菜单项放在这里  -->
                        <StackPanel
                            Margin="{TemplateBinding Padding}"
                            IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  菜单项  -->
    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="ItemBorder"
                        Background="Transparent"
                        CornerRadius="3">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  「加载更多」文字按钮：无边框无底色，看起来就是一行可点的文字  -->
    <Style x:Key="LoadMoreLinkStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource LinkTextColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ButtonHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextColor}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  ========== 带右下角单位后缀的 TextBox 样式（暗色主题适配） ==========  -->
    <!--  使用方式：Style="{StaticResource UnitTextBoxStyle}"  Tag="填写单位，如 kHz / MHz / W"  -->
    <Style x:Key="UnitTextBoxStyle" TargetType="TextBox">
        <!--  基础默认值，和你现有普通输入框保持一致  -->
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextAlignment" Value="Center" />

        <!--  核心：重写控件外观模板  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--  最外层边框：负责背景、边框、圆角  -->
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                        <!--  内部网格：层叠放置输入内容 + 单位文字  -->
                        <Grid>
                            <!--  【必须保留】输入内容宿主，PART_ContentHost 是WPF固定命名，不能改名  -->
                            <!--  右侧Padding预留40px空间，防止输入文字和单位重叠  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="8,4,42,4"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <!--  右下角单位提示文字  -->
                            <TextBlock
                                Margin="0,0,3,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="8"
                                Foreground="{StaticResource PlaceholderTextColor}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Tag}" />
                        </Grid>
                    </Border>

                    <!--  触发器：输入框获得焦点时，边框变成主题蓝色  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  时间标题文字基础样式  -->
    <Style x:Key="TimeStyle_" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />

    </Style>

    <!--  时间标题文字样式  -->
    <Style
        x:Key="TimeLabelStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="12" />

    </Style>

    <!--  时间显示文字样式  -->
    <Style
        x:Key="TimeStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="Padding" Value="0,0,0,0" />
    </Style>

    <!--  日期显示文字样式  -->
    <Style
        x:Key="TimeDataStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />
    </Style>

    <!--  时间内容框格式  -->
    <Style
        x:Key="TimeBorder"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">

        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />

    </Style>

    <!--  UTC时区加减文本  -->
    <Style x:Key="UTCZoneStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />

    </Style>



    <!--  ==================== 滚动条滑块（Thumb）共用样式 ====================  -->
    <!--  垂直/水平滚动条共用此滑块外观，改颜色只需改这里一处  -->
    <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="thumbBorder"
                        Background="{StaticResource ScrollBarThumbNormalBrush}"
                        CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <!--  鼠标悬停：滑块变亮  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                        <!--  正在拖拽：滑块最亮  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbDragBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== 【垂直滚动条】样式 ====================  -->
    <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【滚动条宽度】就在这里改！单位=像素，建议范围 6~12：
                6  = 纤细（当前值）
                8  = 常规
                10 = 更容易用鼠标点中
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Width" Value="6" />
            <!--
                ★ 必须保留这一行，否则上面的 Width 改小于 16.8 不会生效！★
                原因：WPF 主题样式（ThemeStyle）给 ScrollBar 设了
                MinWidth = SystemParameters.VerticalScrollBarWidth = 16.8
                而显式 Style 与主题样式是两个独立来源——本样式没设置 MinWidth 时，
                主题样式的 16.8 依然生效，实际宽度会被撑到 max(Width, 16.8)。
                显式写成 0 才能让 Width 真正说了算。
            -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!--  轨道底色  -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

                            <!--
                                ★ 关键属性：IsDirectionReversed="True" ★
                                作用：让滑块的移动方向与内容滚动方向一致
                                （内容在顶部 → 滑块在顶部；向下滚动 → 滑块向下）
                                注意：垂直滚动条【必须】加这个属性，否则方向会整个反过来
                                （表现为：内容在顶部时滑块却停在底部）
                                水平滚动条则不需要此属性（见下方横向样式）
                            -->
                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Orientation="Vertical">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <!--  ==================== 【水平滚动条】样式 ====================  -->
    <!--  用途：横向滚动时使用（配合下方的 DarkBothScrollViewerStyle 或单独给 ScrollBar 使用）  -->
    <Style x:Key="DarkHorizontalScrollBarStyle" TargetType="ScrollBar">
        <Style.Setters>
            <!--
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
                【横向滚动条高度】就在这里改！单位=像素，建议与垂直滚动条宽度保持一致：
                当前值 8（与垂直滚动条宽度一致）
                ★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★
            -->
            <Setter Property="Height" Value="8" />
            <!--  ★ 同垂直滚动条：必须覆盖主题样式强加的 MinHeight（同样约 16.8），否则高度改不小 ★  -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!--  轨道底色  -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />

                            <!--
                                水平方向使用 Track 的默认方向即可（无需 IsDirectionReversed）
                                因为从左到右滚动时，滑块本来就应该从左往右移动
                            -->
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>

    <!--  ==================== ScrollViewer 模板：仅垂直滚动条 ====================  -->
    <!--  用途：右侧日志列表等只需上下滚动的区域（当前 MainLogWindow 使用此样式）  -->
    <Style x:Key="DarkOnlyVerticalScrollViewerStyle" TargetType="ScrollViewer">
        <!--  水平滚动条彻底禁用（内容超宽时也不会出现横向滚动条）  -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  主体内容区域（承载要滚动的内容）  -->
                        <ScrollContentPresenter
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条  -->
                        <!--
                            说明：Visibility 必须绑定 ComputedVerticalScrollBarVisibility
                            （实际计算后的可见性），不能绑定 VerticalScrollBarVisibility
                            （那是设置值，类型为 ScrollBarVisibility 枚举，与 Visibility 不匹配，
                            会导致 VerticalScrollBarVisibility="Auto" 时无法正确显示）
                        -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== ScrollViewer 模板：横竖双向滚动条 ====================  -->
    <!--
        用途：需要横向滚动的区域（如宽表格、长文本不换行的列表）改用此样式即可。

        【横向滚动条开关】在使用处用属性控制，无需改本样式：
            默认（不写）= Auto   → 内容超出宽度时自动出现横向滚动条
            想关闭       = 在 ScrollViewer 上写 HorizontalScrollBarVisibility="Disabled"
            想常显示     = 写 HorizontalScrollBarVisibility="Visible"

        使用示例：
            <ScrollViewer Style="{StaticResource DarkBothScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Auto">
                ...内容...
            </ScrollViewer>
    -->
    <Style x:Key="DarkBothScrollViewerStyle" TargetType="ScrollViewer">
        <!--  两个方向都用 Auto：内容超出才出现对应滚动条，不超出则干净无痕  -->
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  主体内容区域  -->
                        <ScrollContentPresenter
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  垂直滚动条（靠右）  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Orientation="Vertical"
                            Style="{StaticResource DarkVerticalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  水平滚动条（靠下）  -->
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Orientation="Horizontal"
                            Style="{StaticResource DarkHorizontalScrollBarStyle}"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                        <!--  右下角补角：横竖滚动条同时出现时填充角落的空白  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource ScrollBarTrackBrush}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TimeInPut_HC"
        BasedOn="{StaticResource {x:Type hc:DateTimePicker}}"
        TargetType="hc:DateTimePicker">
        <Setter Property="DateTimeFormat" Value="yyyy/MM/dd-HH:mm:ss" />
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
