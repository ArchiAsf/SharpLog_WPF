<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--  主窗体背景、字体  -->
    <SolidColorBrush x:Key="LogMainFormBackColor" Color="#FF121418" />
    <SolidColorBrush x:Key="LogMainFormFontColor" Color="#FFF0F2F5" />

    <!--  卡片Panel容器  -->
    <SolidColorBrush x:Key="PanelBackColor" Color="#FF202328" />
    <SolidColorBrush x:Key="InPanelBackColor" Color="#FF121418" />
    <SolidColorBrush x:Key="PanelBorderColor" Color="#FF3C3F46" />

    <!--  Label文字色系  -->
    <SolidColorBrush x:Key="LabelMainTitleColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LabelTextColor" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="LabelSecondaryNoteColor" Color="#FFC8CBD2" />

    <!--  TextBox输入框 正常状态  -->
    <SolidColorBrush x:Key="NormalTextBoxBackColor" Color="#FF2D3037" />
    <SolidColorBrush x:Key="NormalTextBoxTextColor" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="NormalTextBoxBorderColor" Color="#FF3C3F46" />
    <!--  TextBox 焦点状态  -->
    <SolidColorBrush x:Key="FocusTextBoxTextColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FocusTextBoxBorderColor" Color="#FF2962FF" />

    <!--  主Button按钮  -->
    <SolidColorBrush x:Key="ButtonNormalBackColor" Color="#FF2962FF" />
    <SolidColorBrush x:Key="ButtonNormalTextColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackColor" Color="#FF487EFF" />
    <SolidColorBrush x:Key="ButtonClickBackColor" Color="#FF1646B4" />
    <SolidColorBrush x:Key="ButtonDisabledBackColor" Color="#FF233250" />
    <SolidColorBrush x:Key="ButtonDisabledTextColor" Color="#FF787D87" />

    <!--  保存按钮（绿色实心）—— 用于"保存"这类确认性主操作，
          与主按钮的蓝形成语义区分。与 SuccessTextColor(#4EC9B0) 同一色系。  -->
    <SolidColorBrush x:Key="SuccessButtonNormalBackColor" Color="#FF2E9E63" />
    <SolidColorBrush x:Key="SuccessButtonHoverBackColor" Color="#FF3FBF7C" />
    <SolidColorBrush x:Key="SuccessButtonClickBackColor" Color="#FF1F7A4A" />

    <!--  DataGrid 日志表格（原DataGridView）  -->
    <SolidColorBrush x:Key="DgvHeaderBackColor" Color="#FF202328" />
    <SolidColorBrush x:Key="DgvHeaderTextColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DgvHeaderBorderColor" Color="#FF3C3F46" />
    <SolidColorBrush x:Key="DgvRowNormalBackColor" Color="#FF121418" />
    <SolidColorBrush x:Key="DgvRowNormalTextColor" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="DgvRowSelectedBackColor" Color="#FF2962FF" />
    <SolidColorBrush x:Key="DgvRowSelectedTextColor" Color="#FFFFFFFF" />

    <!--  ========== 【拓展1：文字层级补充】强调、辅助、占位文字 ==========  -->
    <!--  强调高亮文字（主色蓝，用于呼号、频率、关键数字高亮）  -->
    <SolidColorBrush x:Key="AccentTextColor" Color="Goldenrod" />
    <!--  超链接/可点击文字色  -->
    <SolidColorBrush x:Key="LinkTextColor" Color="#FF6BA1FF" />
    <!--  输入框占位符(Placeholder)灰色文字  -->
    <SolidColorBrush x:Key="PlaceholderTextColor" Color="#FF6B6F78" />
    <!--  最弱辅助文字（水印、提示、脚注）  -->
    <SolidColorBrush x:Key="LabelTertiaryNoteColor" Color="#FF8A8E97" />
    <!--  成功状态文字（绿色，通联成功、保存成功提示）  -->
    <SolidColorBrush x:Key="SuccessTextColor" Color="#FF4EC9B0" />
    <!--  警告状态文字（橙黄色，格式提醒、必填提示）  -->
    <SolidColorBrush x:Key="WarningTextColor" Color="#FFD7A84A" />
    <!--  错误/危险文字（红色，校验失败、删除确认、报错提示）  -->
    <SolidColorBrush x:Key="ErrorTextColor" Color="#FFF16C6C" />

    <!--  ========== 【拓展2：语义状态背景+边框】提示条、校验、标签徽章 ==========  -->
    <!--  成功状态：浅绿背景 + 边框（用于成功提示条、已同步标签）  -->
    <SolidColorBrush x:Key="SuccessBackColor" Color="#FF1B3A35" />
    <SolidColorBrush x:Key="SuccessBorderColor" Color="#FF2E6B60" />

    <!--  警告状态：浅橙背景 + 边框（用于必填提醒、格式警告）  -->
    <SolidColorBrush x:Key="WarningBackColor" Color="#FF3A301B" />
    <SolidColorBrush x:Key="WarningBorderColor" Color="#FF6B552E" />

    <!--  错误状态：浅红背景 + 边框（用于输入校验失败、错误提示框）  -->
    <SolidColorBrush x:Key="ErrorBackColor" Color="#FF3A1F1F" />
    <SolidColorBrush x:Key="ErrorBorderColor" Color="#FF6B3333" />

    <!--  信息状态：浅蓝背景 + 边框（和主色呼应，普通提示、说明条）  -->
    <SolidColorBrush x:Key="InfoBackColor" Color="#FF1A2B4D" />
    <SolidColorBrush x:Key="InfoBorderColor" Color="#FF294F8A" />

    <!--  ========== 【拓展3：辅助UI元素色】分割线、阴影、次要按钮 ==========  -->
    <!--  列表/卡片内部分割线（比边框更淡）  -->
    <SolidColorBrush x:Key="DividerColor" Color="#FF2A2D33" />
    <!--  悬浮遮罩层半透明黑（弹窗、下拉菜单背景）  -->
    <SolidColorBrush x:Key="OverlayMaskColor" Color="#80000000" />

    <!--  次要按钮（幽灵按钮/边框按钮）正常态  -->
    <SolidColorBrush x:Key="SecondaryButtonBorderColor" Color="#FF3C3F46" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackColor" Color="#FF2A2D33" />
    <!--  次要按钮按下态（比 Hover 再亮一档，形成按压反馈）  -->
    <SolidColorBrush x:Key="SecondaryButtonClickBackColor" Color="#FF343841" />

    <!--  危险操作按钮（删除、清空日志）红系配色  -->
    <SolidColorBrush x:Key="DangerButtonNormalBackColor" Color="#FFC0392B" />
    <SolidColorBrush x:Key="DangerButtonHoverBackColor" Color="#FFE04F3F" />
    <SolidColorBrush x:Key="DangerButtonClickBackColor" Color="#FF922B20" />

    <!--  ========== 【拓展4：RadioButton/CheckBox 勾选强调色】和主蓝统一 ==========  -->
    <SolidColorBrush x:Key="CheckAccentColor" Color="#FF2962FF" />
    <SolidColorBrush x:Key="CheckDisabledColor" Color="#FF55585F" />

    <!--  ========== TabControl / TabItem 暗色主题样式（适配日志双标签：日志编辑 / 日志查看） ==========  -->
    <!--  Tab头部背景（未选中）  -->
    <SolidColorBrush x:Key="TabItemNormalBackColor" Color="#FF202328" />
    <!--  Tab头部背景（选中激活）  -->
    <SolidColorBrush x:Key="TabItemSelectedBackColor" Color="#FF121418" />
    <!--  Tab头部悬浮背景  -->
    <SolidColorBrush x:Key="TabItemHoverBackColor" Color="#FF2C3038" />
    <!--  Tab头部文字（未选中）  -->
    <SolidColorBrush x:Key="TabItemNormalTextColor" Color="#FFC8CBD2" />
    <!--  Tab头部文字（选中）  -->
    <SolidColorBrush x:Key="TabItemSelectedTextColor" Color="#FFFFFFFF" />
    <!--  Tab分割线、边框颜色  -->
    <SolidColorBrush x:Key="TabBorderBrush" Color="#FF3C3F46" />

    <!--  时间日期显示颜色  -->
    <SolidColorBrush x:Key="TimeDataColor" Color="#FF787D87" />

    <!--  滚动条配套色（沿用暗色主题体系）  -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FF262930" />
    <SolidColorBrush x:Key="ScrollBarThumbNormalBrush" Color="#FF444850" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FF606570" />
    <SolidColorBrush x:Key="ScrollBarThumbDragBrush" Color="#FF787E8A" />

</ResourceDictionary>