<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">



    <!--  ================================================================
          DataGrid 暗色样式（日志查看页的表格）
          ────────────────────────────────────────────────────────────────
          配色全部取自 ColorDic.xaml 里已有的 Dgv* 色键，未新增颜色：
            表头      DgvHeaderBackColor / DgvHeaderTextColor / DgvHeaderBorderColor
            数据行    DgvRowNormalBackColor / DgvRowNormalTextColor
            选中行    DgvRowSelectedBackColor / DgvRowSelectedTextColor
          ================================================================  -->

    <!--  表头单元格  -->
    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DgvHeaderBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvHeaderTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!--  表头文字居中，与单元格内容的默认对齐保持一致，否则上下会错位  -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!--  表头重写模板：原生模板的背景是浅色硬编码的，只改 Setter 不管用  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border
                            x:Name="BackgroundBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                                    <!--
                                      ★ 这里解决「表头换行后看着不居中」的问题 ★
                                      Header 传入含换行符的字符串时，ContentPresenter 会自动
                                      生成一个 TextBlock 来显示它。此时两层对齐是分开管的：
                                        · HorizontalContentAlignment 管【整个 TextBlock】
                                          在表头格子里的位置
                                        · TextAlignment 管【TextBlock 内部每一行】的位置
                                      只设前者不设后者，就会出现「长的那行看着居中、
                                      短的那行却偏左」的错位。所以这里给自动生成的
                                      TextBlock 补上 TextAlignment。
                                    -->
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <!--  排序方向箭头，仅在该列参与排序时出现  -->
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!--
                          ⚠ 这两个 Thumb 是【列宽拖拽手柄】，必须保留。
                            漏掉它们的话模板照样能显示，但用户会发现列宽拖不动了。
                            这里设成完全透明：手柄只负责响应鼠标，不参与外观。
                        -->
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Left"
                            Cursor="SizeWE"
                            Opacity="0" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            Width="6"
                            HorizontalAlignment="Right"
                            Cursor="SizeWE"
                            Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <!--  向上的三角  -->
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 7,4 L 3.5,0 Z" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <!--  向下的三角  -->
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 7,0 L 3.5,4 Z" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  数据行  -->
    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="MinHeight" Value="26" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TabItemHoverBackColor}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DgvRowSelectedBackColor}" />
                <Setter Property="Foreground" Value="{StaticResource DgvRowSelectedTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  单元格（默认：内容居中）  -->
    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
        <!--
          单元格背景设为透明，让【行的背景】透上来。
          否则选中时单元格会自己涂一层，与行的选中色打架，
          出现"整行蓝底、格子却是别的颜色"的花斑。
        -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <!--  原生模板里带一圈选中虚线框，一并去掉  -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!--
          ★ 默认【居中】★
          呼号、时间、频率、波段、模式这类短数据居中排布看起来最整齐，
          而它们在表格里占绝大多数，所以把居中定为默认值，
          只有地址、备注这类长文本的列才单独换成左对齐
          （见下面的 DarkDataGridLeftCellStyle）。
        -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <!--
                          ⚠ HorizontalAlignment 必须用 TemplateBinding 接上 HorizontalContentAlignment，
                            否则上面那个居中设置【完全不起作用】——
                            ContentPresenter 默认是 Stretch，会把文字块拉满整个格子宽度，
                            看起来永远是左对齐。这是自定义 DataGridCell 模板时最常见的坑。
                        -->
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  单元格（长文本用：内容靠左）  -->
    <!--
      适用列：地址、备注、城市、设备型号这类长短不一的自由文本。
      为什么必须靠左：内容超出列宽时，居中会让左右两端都被裁掉，
      用户连开头都看不全；靠左至少能从头读起。
      用法：在列上写 CellStyle="{StaticResource DarkDataGridLeftCellStyle}"
    -->
    <Style
        x:Key="DarkDataGridLeftCellStyle"
        BasedOn="{StaticResource DarkDataGridCellStyle}"
        TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!--  表格整体  -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <!--  ──── 配色 ────  -->
        <Setter Property="Background" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource DgvRowNormalTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource DgvRowNormalBackColor}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DgvHeaderBorderColor}" />
        <!--
          网格线只画横线。列有三十多个，竖线会密得像栅栏，反而看不清内容；
          横向的格线足够帮眼睛在一行里对齐。
        -->
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <!--  行表头没什么用，关掉可以省下一列宽度  -->
        <Setter Property="HeadersVisibility" Value="Column" />

        <!--  ──── 行为 ────  -->
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <!--  只读：编辑走悬浮窗口，不放任在表格里直接改  -->
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <!--
          ★ 允许拖拽表头调整列顺序 ★
          本项默认为 True，这里显式写出来是为了让人一眼看到它是有意开启的。
          用法：按住某一列的表头往左右拖，松手即换位。
          ⚠ 前提是列由 XAML 手工定义（AutoGenerateColumns=False）。
            若让 DataGrid 自动生成列，重新绑定数据时列会被重建，顺序就丢了。
        -->
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="RowHeight" Value="26" />

        <!--
          ★ 列宽默认值：按【表头】的宽度自动定初始列宽 ★
          这样每条列定义就不必逐个写 Width，改宽度策略也只改这一处。
          用户仍可随时拖拽表头边缘调整（CanUserResizeColumns=True）。

          ⚠ 三种列宽模式的性能差别很大，别混用：
            · SizeToHeader —— 只测量【表头】。开销极小，本项目采用。
            · Auto         —— 要遍历【所有已加载行】的内容来取最大值。
                              2000 行 × 39 列会明显卡顿，本项目禁用。
            · 固定像素值   —— 最快，但表头文字一变长（比如换语言）就会被截断。
        -->
        <Setter Property="ColumnWidth" Value="SizeToHeader" />

        <!--
          ──── 虚拟化（数据量大时的命脉）────
          这三项配合起来，DataGrid 才只生成"看得见的那二十来行"的行容器，
          显示 2000 条和显示 20 条的渲染开销几乎一样。
        -->
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!--
          ⚠ CanContentScroll 必须保持 True。
            设成 False 会退化成"按像素滚动"，DataGrid 就得把每一行都量一遍才能
            算出总高度，虚拟化直接失效 —— 这是最常见的性能翻车点。
        -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        <!--  ──── 子元素样式 ────  -->
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DarkDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DarkDataGridCellStyle}" />
    </Style>

</ResourceDictionary>
