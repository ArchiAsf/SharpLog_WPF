<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">


    <!--  ══════════════════════════════════════════════════════════════════════
          EditQso 编辑窗口专用样式（主表部分）
          ──────────────────────────────────────────────────────────────────────
          风格基线：与设置页、主界面保持一致 ——
            底色沿用 LogMainFormBackColor(#121418) / PanelBorderColor(#3C3F46)
            强调色沿用 FocusTextBoxBorderColor(#2962FF)
            按钮直接基于主界面 PrimaryButtonStyle，不复制内容
          ══════════════════════════════════════════════════════════════════════  -->

    <!--  标签外框：透明无边框，只做布局占位（用户要求「标签不要边框」）  -->
    <Style x:Key="EditTitlePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <!--  输入框外框：同样透明无边框（底下那根线由 EditTextBoxStyle 自己画）  -->
    <Style x:Key="EditInputPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <!--  按钮外框：透明无边框（圆角背景由按钮自己带）  -->
    <Style x:Key="EditButtonPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!--  编辑窗口的标签文字（主表 7 行的字段名）  -->
    <Style
        x:Key="EditLabelStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!--  ⚠ 文字居中要两层：外层 HorizontalContentAlignment 管 Label 内部
              的内容摆放，单靠 HorizontalAlignment 只把 Label 自身居中而已  -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!--  ⚠ 这两个由用户预留，本次暂不使用，保留空定义  -->
    <Style x:Key="EditBigFontStyle" TargetType="Label" />
    <Style x:Key="EditSmallFontStyle" TargetType="Label" />

    <!--
      编辑窗口的输入框
      ─────────────────────────────────────────────────────────────────────
      · 背景透明，四周边框全去掉，只保留底部一根 1px 的线
      · 未聚焦：NormalTextBoxBorderColor(#3C3F46) 灰线
      · 已聚焦：叠一根 2px 的 FocusTextBoxBorderColor(#2962FF) 蓝线
      ⚠ 聚焦的「加粗」刻意没有去改 BorderThickness ——
        Border 的边框是从内边缘开始占位的，底边 1px 改成 2px 会把
        里面的文字整体顶高 1px，输入时文字会「跳」一下。
        这里改成在网格上层叠一条高 2px、底对齐的色块，向上长 1px，
        内容位置一个像素都不动。
    -->
    <Style x:Key="EditTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="2,3,2,3" />
        <!--  主表的输入框内容居中（与 DarkTextBoxStyle 的做法一致）  -->
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!--  内容层：底下那根 1px 的线画在这里，位置恒定  -->
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                        <!--  聚焦高亮层：平时隐藏，聚焦时才盖上去  -->
                        <Border
                            x:Name="FocusLine"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource FocusTextBoxBorderColor}"
                            SnapsToDevicePixels="True"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  编辑窗口的按钮：完全沿用主界面的主要按钮，只换个键名方便后续微调  -->
    <Style
        x:Key="EditButtonStyle"
        BasedOn="{StaticResource PrimaryButtonStyle}"
        TargetType="Button"></Style>


    <!--  ══════════════════════════════════════════════════════════════════════
          滚动区专用样式
          ──────────────────────────────────────────────────────────────────────
          滚动区 8 行要挤在主表 5 行的高度里，横向只有整个宽度的 1/2，
          比主表明显局促，因此字号、内边距都单独收紧一档，不与主表共用。
          ⚠ 这些样式必须定义在 EditTextBoxStyle 之后（BasedOn 依赖）。
          ══════════════════════════════════════════════════════════════════════  -->

    <!--  滚动区大外框：做成一块内嵌面板，与周围窗口底色拉开一档  -->
    <Style
        x:Key="EditScrollPanelStyle"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="6,4,6,4" />
    </Style>

    <!--  滚动区字段名的外框：透明无边框  -->
    <Style x:Key="EditScrollTitlePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <!--  滚动区字段值的外框：透明无边框  -->
    <Style x:Key="EditScrollInputPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <!--  滚动区字段名文字：比主表标签小一号，且不加粗（右列的值才是主角）  -->
    <Style
        x:Key="EditScrollLabelStyle"
        BasedOn="{StaticResource LabelTextStyle}"
        TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2,0,2,0" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!--  滚动区字段值输入框：沿用主表的底线风格，只是更紧凑  -->
    <Style
        x:Key="EditScrollTextBoxStyle"
        BasedOn="{StaticResource EditTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="2,2,2,2" />
        <!--
          ⚠ 必须显式覆盖回靠左。
          EditTextBoxStyle 现在是 TextAlignment=Center，派生样式会继承过去；
          而滚动区是「字段名 : 字段值」的密集列表，值要靠左才与字段名对齐好看。
        -->
        <Setter Property="TextAlignment" Value="Left" />
    </Style>
    




    <!--  ══════════════════════════════════════════════════════════════════════
          EditQso 编辑窗口里的 HandyControl 控件样式
          ──────────────────────────────────────────────────────────────────────
          思路：继承 HandyControl 自带的样式，只覆盖颜色与边框，
                尽量贴近编辑窗口其余部分的「透明底 + 底部一条线」风格。

          ⚠ 这几个控件的 ControlTemplate 由 HandyControl 提供，改属性能否生效
            取决于它的模板有没有用 TemplateBinding 接这些属性。
            若实跑下来外观没变化，需要改成重写 ControlTemplate。

          ⚠ 三个样式都依赖 hc: 前缀，本文件顶部已声明该命名空间。
          ══════════════════════════════════════════════════════════════════════  -->

    <!--  时间选择框（hc:DateTimePicker）：透明底 + 只留底部一条线  -->
    <Style
        x:Key="EditDateTimePickerStyle"
        BasedOn="{StaticResource {x:Type hc:DateTimePicker}}"
        TargetType="hc:DateTimePicker">
        <!--  与主界面 TimeInPut_HC 用同一种时间格式，保证两处显示一致  -->
        <Setter Property="DateTimeFormat" Value="yyyy/MM/dd-HH:mm:ss" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
    </Style>

    <!--  下拉框（模式 / 传播模式）：透明底 + 只留底部一条线  -->
    <Style
        x:Key="EditComboBoxStyle"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  数字增减框（分组 / 星级）：透明底 + 只留底部一条线，保留上下箭头按钮  -->
    <Style
        x:Key="EditNumericUpDownStyle"
        BasedOn="{StaticResource {x:Type hc:NumericUpDown}}"
        TargetType="hc:NumericUpDown">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
    </Style>

</ResourceDictionary>
