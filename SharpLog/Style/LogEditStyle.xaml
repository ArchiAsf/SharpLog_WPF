<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">


    <!--  「加载更多」文字按钮：无边框无底色，看起来就是一行可点的文字  -->
    <Style x:Key="LoadMoreLinkStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource LinkTextColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ButtonHoverBackColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderTextColor}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  ========== 带右下角单位后缀的 TextBox 样式（暗色主题适配） ==========  -->
    <!--  使用方式：Style="{StaticResource UnitTextBoxStyle}"  Tag="填写单位，如 kHz / MHz / W"  -->
    <Style x:Key="UnitTextBoxStyle" TargetType="TextBox">
        <!--  基础默认值，和你现有普通输入框保持一致  -->
        <Setter Property="Background" Value="{StaticResource NormalTextBoxBackColor}" />
        <Setter Property="Foreground" Value="{StaticResource NormalTextBoxTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource NormalTextBoxBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextAlignment" Value="Center" />

        <!--  核心：重写控件外观模板  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--  最外层边框：负责背景、边框、圆角  -->
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                        <!--  内部网格：层叠放置输入内容 + 单位文字  -->
                        <Grid>
                            <!--  【必须保留】输入内容宿主，PART_ContentHost 是WPF固定命名，不能改名  -->
                            <!--  右侧Padding预留40px空间，防止输入文字和单位重叠  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="8,4,42,4"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <!--  右下角单位提示文字  -->
                            <TextBlock
                                Margin="0,0,3,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="8"
                                Foreground="{StaticResource PlaceholderTextColor}"
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{TemplateBinding Tag}" />
                        </Grid>
                    </Border>

                    <!--  触发器：输入框获得焦点时，边框变成主题蓝色  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FocusTextBoxBorderColor}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  时间标题文字基础样式  -->
    <Style x:Key="TimeStyle_" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />

    </Style>

    <!--  时间标题文字样式  -->
    <Style
        x:Key="TimeLabelStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="FontSize" Value="12" />

    </Style>

    <!--  时间显示文字样式  -->
    <Style
        x:Key="TimeStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource LabelMainTitleColor}" />
        <Setter Property="Padding" Value="0,0,0,0" />
    </Style>

    <!--  日期显示文字样式  -->
    <Style
        x:Key="TimeDataStyle"
        BasedOn="{StaticResource TimeStyle_}"
        TargetType="Label">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />
    </Style>

    <!--  时间内容框格式  -->
    <Style
        x:Key="TimeBorder"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">

        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />

    </Style>

    <!--  UTC时区加减文本  -->
    <Style x:Key="UTCZoneStyle" TargetType="Label">
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TimeDataColor}" />

    </Style>

</ResourceDictionary>
