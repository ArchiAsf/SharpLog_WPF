<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl">
    <!--
      ⚠ 必须【先】合并 BaseStyle：
        BasedOn 里的 StaticResource 是在【本字典被加载的那一刻】求值的，
        而那时 FormStyle 的其它兄弟册还没合并进来 —— 只有本字典自己
        MergedDictionaries 里的东西才在查找范围内。
        （Setter 里的 StaticResource 是延迟到样式被使用时才求值，所以不受此限）
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Style/BaseStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ══════════════════════════════════════════════════════════════════
          日志查看页 · 左侧「查询 / 筛选 / 统计」区专用样式

          配色一律取自 ColorDic.xaml，不新增色值：
            · 外层卡片 #202328（PanelBackColor）
            · 内嵌面板 #121418（InPanelBackColor）
            · 边框     #3C3F46（PanelBorderColor）
            · 关键数字 Goldenrod（AccentTextColor）——对应既有的
              「呼号 / 频率 / 关键数字高亮」约定
          ══════════════════════════════════════════════════════════════════  -->

    <!--  查询区整体外框：内嵌面板（比表格外层更暗一档，形成层次）  -->
    <Style
        x:Key="QueryPanelStyle"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">
        <Setter Property="Margin" Value="2,2,2,2" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  顶栏：标题 + 操作按钮，底部压一条 1px 分割线  -->
    <Style x:Key="QueryTitlePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,3,6,3" />
    </Style>

    <!--  顶栏标题文字  -->
    <Style
        x:Key="QueryTitleStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  小节标题（「查询条件」「筛选器」）：次要色，与顶栏标题拉开层级  -->
    <Style
        x:Key="QuerySectionLabelStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource LabelSecondaryNoteColor}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,7,0,3" />
    </Style>

    <!--  条件行里的字段名标签：小字、左对齐、垂直居中  -->
    <Style
        x:Key="QueryFieldLabelStyle"
        BasedOn="{StaticResource LabelTextStyle}"
        TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource LabelTertiaryNoteColor}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  值输入框：沿用全局输入框底色，字号收小以适配窄栏  -->
    <Style
        x:Key="QueryInputTextBoxStyle"
        BasedOn="{StaticResource DarkTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  条件行末尾的删除小按钮（正方形）  -->
    <Style
        x:Key="QueryMiniButtonStyle"
        BasedOn="{StaticResource SecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="2,0,2,0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  「+ 添加条件」按钮：占满整行  -->
    <Style
        x:Key="QueryAddButtonStyle"
        BasedOn="{StaticResource SecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--  统计格子：内嵌面板，四边留 2px 视觉间隙  -->
    <Style
        x:Key="QueryStatCellStyle"
        BasedOn="{StaticResource InCardPanelStyle}"
        TargetType="Border">
        <Setter Property="Margin" Value="2,2,2,2" />
        <Setter Property="Padding" Value="2,4,2,4" />
    </Style>

    <!--  统计数字：大号 + 金色强调  -->
    <Style
        x:Key="QueryStatNumberStyle"
        BasedOn="{StaticResource LabelMainTitleStyle}"
        TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextColor}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  统计标签：小字次要色，居中  -->
    <Style
        x:Key="QueryStatCaptionStyle"
        BasedOn="{StaticResource LabelSecondaryNoteStyle}"
        TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

</ResourceDictionary>
