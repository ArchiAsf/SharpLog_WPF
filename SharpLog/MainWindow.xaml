<Window
    x:Class="SharpLog.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SharpLog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SharpLog"
    Width="1366"
    Height="768"
    MinWidth="1366"
    MinHeight="768"
    Style="{StaticResource LogMainWindowStyle}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <TabControl Style="{StaticResource DarkTabControlStyle}">
        <TabItem Header="日志编辑" Style="{StaticResource DarkTabItemStyle}">
            <Border Margin="0" Style="{StaticResource CardPanelStyle}">
                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7.5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="8*" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!--  顶部工具栏容器  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CardPanelStyle}" />

                    <!--  主要功能实现区  -->
                    <Border Grid.Row="1" Grid.Column="0">
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3.5*" />
                                <RowDefinition Height="3.5*" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>

                            <!--  左侧第一列栏  -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                Style="{StaticResource CardPanelStyle}" />
                            <!--  中间主要栏  -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Style="{StaticResource CardPanelStyle}">
                                <Grid Grid.RowSpan="2" Grid.Column="1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="6*" />
                                        <RowDefinition Height="6*" />
                                        <RowDefinition Height="6*" />
                                        <RowDefinition Height="6*" />
                                        <RowDefinition Height="7*" />
                                        <RowDefinition Height="7*" />
                                        <RowDefinition Height="7*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：开始时间 StartTime  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                开始时间<LineBreak />
                                                StartTime</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  开始时间输入框  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="StartTimeInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：结束时间 EndTime  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                结束时间<LineBreak />
                                                EndTime</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  结束时间输入框  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="EndTimeInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：备注 RMKS  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                备注<LineBreak />
                                                RMKS</TextBlock>
                                        </Label>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：呼号 CallSign  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                呼号<LineBreak />
                                                CallSign</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  呼号输入框  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="CallSignInPutBox"
                                            FontSize="20"
                                            Foreground="{StaticResource AccentTextColor}"
                                            Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：模式 Mode  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                模式<LineBreak />
                                                Mode</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  模式输入框  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="ModeInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <!--  备注多行输入框（纵向跨6行，右侧大区域）  -->
                                    <Border
                                        Grid.Row="1"
                                        Grid.RowSpan="6"
                                        Grid.Column="6"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox
                                            x:Name="RmksInPutBox"
                                            AcceptsReturn="True"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：频率 Freq  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                频率<LineBreak />
                                                Freq</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  频率输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="FreqInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：信号报告_收 RST  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                信号报告_收<LineBreak />
                                                RST</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  接收信号报告输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="RstInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：信号报告_发 RRST  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                信号报告_发<LineBreak />
                                                RRST</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  发射信号报告输入框  -->
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="RrstInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：发射功率_收 Power  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                发射功率_收<LineBreak />
                                                Power</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  接收功率输入框  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="RxPowerInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：发射功率_发 Power  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                发射功率_发<LineBreak />
                                                Power</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  发射功率输入框  -->
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="TxPowerInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：地理位置 QTH  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                地理位置<LineBreak />
                                                QTH</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  QTH地理位置输入框  -->
                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="QthInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：设备 RIG  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                设备<LineBreak />
                                                RIG</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  设备RIG输入框  -->
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="RigInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>

                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource CardPanelStyle}">
                                        <!--  字段标签：天线 ANT  -->
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LabelMainTitleStyle}">
                                            <TextBlock TextAlignment="Center">
                                                天线<LineBreak />
                                                ANT</TextBlock>
                                        </Label>
                                    </Border>
                                    <!--  天线ANT输入框  -->
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="5"
                                        Style="{StaticResource InCardPanelStyle}">
                                        <TextBox x:Name="AntInPutBox" Style="{StaticResource DarkTextBoxStyle}" />
                                    </Border>
                                </Grid>
                            </Border>


                            <!--  中间下方栏  -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CardPanelStyle}" />

                        </Grid>
                    </Border>


                    <!--  中间右侧容器  -->
                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Style="{StaticResource CardPanelStyle}" />

                    <!--  底部容器  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource CardPanelStyle}" />


                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="日志查看" Style="{StaticResource DarkTabItemStyle}" />
    </TabControl>
</Window>
