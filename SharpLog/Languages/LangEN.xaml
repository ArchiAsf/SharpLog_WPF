<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!--
      ⚠ 本文件的键必须与 LangCN.xaml【一一对应】，少一个键就会导致
        切到英文后那处文字变成空白。新增界面文字时两个文件都要加。

      ⚠ 业余无线电的通用缩写【不翻译】—— QSO / QSL / CALL / CW / SSB /
         DXCC / CQ / ITU / Maidenhead 这些都是国际通行写法，
         翻译成中文反而看不懂。
    -->

    <!--  ── 原有 11 项 ──  -->
    <system:String x:Key="Text_Group">Group</system:String>
    <system:String x:Key="Text_Star">Star</system:String>
    <system:String x:Key="Text_QslReceived">QSL Card Received</system:String>
    <system:String x:Key="Text_QslMailAddress">QSL Mailing Address</system:String>
    <system:String x:Key="Text_PostalCode">Postal Code</system:String>
    <system:String x:Key="Text_ReceiverName">Receiver Name</system:String>
    <system:String x:Key="Text_ReceiverContact">Receiver Contact</system:String>
    <system:String x:Key="Text_QslSendTime">QSL Sent</system:String>
    <system:String x:Key="Text_QslReceiveTime">QSL Received</system:String>
    <system:String x:Key="Text_Weather">Weather</system:String>
    <system:String x:Key="Text_Temperature">Temperature</system:String>

    <!--  ── 底部状态栏 ──  -->
    <system:String x:Key="Text_NowTimeZone">Time Zone: </system:String>
    <system:String x:Key="Text_RadioOperator">Operator: </system:String>
    <system:String x:Key="Text_OperatorGrid">Operator Grid: </system:String>

    <!--  ── 语言切换按钮 ──
           ⚠ 它显示的是"另一种语言"的名字：
             中文界面显示 EN，英文界面显示 中文。
              这样用户一眼就知道点下去会切成什么。  -->
    <!--  ── 日志编辑页界面文字 ──  -->
    <system:String x:Key="Text_TabLogEdit">Log Entry</system:String>
    <system:String x:Key="Text_TimeZoneConvert">Time Zone</system:String>
    <system:String x:Key="Text_StartTime">·Start</system:String>
    <system:String x:Key="Text_EndTime">·End</system:String>
    <system:String x:Key="Text_Comment">Comment</system:String>
    <system:String x:Key="Text_Call">·Call</system:String>
    <system:String x:Key="Text_Mode">·Mode</system:String>
    <system:String x:Key="Text_Freq">·Freq</system:String>
    <system:String x:Key="Text_RstRcvd">RST Rcvd</system:String>
    <system:String x:Key="Text_RstSent">RST Sent</system:String>
    <system:String x:Key="Text_GridSquare">Grid</system:String>
    <system:String x:Key="Text_RxPwr">RX Pwr</system:String>
    <system:String x:Key="Text_TxPwr">TX Pwr</system:String>
    <system:String x:Key="Text_Qth">Location</system:String>
    <system:String x:Key="Text_Rig">Rig</system:String>
    <system:String x:Key="Text_Ant">Antenna</system:String>
    <system:String x:Key="Text_Height">Height</system:String>
    <system:String x:Key="Text_ContactedOp">Op</system:String>
    <system:String x:Key="Text_PropMode">Prop Mode</system:String>
    <system:String x:Key="Text_DigitalId">Digital ID</system:String>
    <system:String x:Key="Text_AddLog">Add Log</system:String>
    <system:String x:Key="Text_OtherInfo">More Info</system:String>

    <system:String x:Key="Text_Yes">Yes</system:String>
    <system:String x:Key="Text_No">No</system:String>
    <system:String x:Key="Text_LanguageToggle">中文</system:String>

</ResourceDictionary>
